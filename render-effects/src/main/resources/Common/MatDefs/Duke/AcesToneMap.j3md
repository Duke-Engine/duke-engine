MaterialDef Aces Tone Map {

    MaterialParameters {
        Int BoundDrawBuffer
        Int NumSamples
        Int NumSamplesDepth
        Texture2D Texture
        Float Exposure : 1.0
        // 1x1: what AcesToneMap's eye has adapted to, green the multiplier it asks of the exposure.
        Texture2D Adapted
    }

    Technique {
        VertexShader     GLSL300 GLSL150 GLSL100: Common/MatDefs/Post/Post.vert
        FragmentShader   GLSL300 GLSL150 GLSL100: Common/MatDefs/Duke/AcesToneMap.frag

        WorldParameters {
        }

        Defines {
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            RESOLVE_MS : NumSamples
            AUTO_EXPOSURE : Adapted
        }
    }
}
