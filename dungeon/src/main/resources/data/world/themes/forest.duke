; ---------------------------------------------------------------------------
; The same dungeon, out of doors.
;
; Nothing is a wall here: what a body cannot cross is drawn as a tree, and the
; rock between the rooms is roofed at ground level rather than at wall height —
; so the whole map is forest floor, with tree lines standing where the corridors
; are not. The layout is the one the generator always draws; only what it is
; made of has changed, which is the whole point of a theme.
;
; WallHeight = 0 is what lays that roof on the ground. WallShift moves each tree
; half a cell back into the rock it stands on, so the trunk marks the edge and
; the canopy leans over the path rather than standing in it.
;
; The floor and the steps come from the dungeon kit — dirt and stone, which a
; forest has as much as a cellar does — and the trees from the forest one. Two
; atlases in one folder, each model naming its own.
; ---------------------------------------------------------------------------
Theme
  Name = Forest
  TileSize = 4
  ; The trees are modelled on their own scale -- about three units across, where
  ; the floor is four -- so they are sized by their own module. Measured off the
  ; model, like every other number on this page.
  WallTileSize = 3.2
  WallHeight = 0
  ; Half a cell back into the rock it stands on, so the trunk marks the edge and
  ; the canopy leans over the path rather than standing in it.
  WallShift = -1.6
  Stairs = models/tiles/forest/stairs.gltf
  ; A tree is not masonry, and these four lines are the whole of that difference.
  ;
  ; WallFillsRock: a wall is a SURFACE -- one piece per face, one course per
  ; storey -- and a tree is a BODY. Both faces of a one-cell wall drew the same
  ; tree twice, once at the foot of the rock and once up on its roof with the
  ; floor between them; two storeys drew it twice more, stacked. Saying Yes here
  ; draws it once per block of rock, in the middle of it and ON TOP of it -- one
  ; tree, standing on the rock's own roof, whatever the rock is.
  ;
  ; The other three break the grid. One tree per cell, all the same size, all the
  ; same way up, reads as an orchard: the eye sees the spacing before it sees the
  ; tree. Three in a ring, each a different size and facing, and the rows go away.
  WallFillsRock = Yes
  WallClump = 3
  WallSpread = 0.28
  WallVariety = 0.5
  ; ★ WHAT THE SIDE OF A RAISED BLOCK OF ROCK IS DRAWN WITH, and the whole of
  ; the second thing the first player complained about: trees hanging in the air
  ; on the upper floors.
  ;
  ; The trouble is that a tree is a BODY. Masonry has none of it: a block of rock
  ; two storeys tall is walled in two courses, and those courses ARE its sides.
  ; There are no courses of tree -- one is drawn, on top -- so the client used to
  ; throw the faces away, and then nothing at all drew the rock. A tree crowning
  ; the block beside a room two storeys up stood at the room's own height with
  ; daylight underneath it.
  ;
  ; So the faces are kept and drawn with this instead: a retaining wall. The
  ; dungeon's own wall, borrowed -- which is why it sits in this theme's PROPS
  ; folder rather than among its tiles, and why the stone stairs already down
  ; here look like they belong beside it.
  ;
  ; Scaled by what it measures rather than by a number written here, so its
  ; height fills exactly one storey and, being a uniform scale on a square slab,
  ; its width fills exactly one cell. Two storeys is two courses.
  ;
  ; ★ Drawn ONLY where the rock stands above the foot of the face. Nearly all the
  ; rock down here is at the floor's own height -- WallHeight = 0 -- and a
  ; retaining wall under every tree would be a stone kerb round the whole forest.
  ;
  ; A theme that leaves this out is drawn exactly as it always was.
  RockFace = models/props/forest/wall.gltf
  ; ★ NO CapTint HERE, deliberately, and it was tried. The lid on the rock is what
  ; every tree stands on, and tinting it put a dark SQUARE under each one -- which
  ; hands the player back the very grid that WallClump, WallSpread and WallVariety
  ; above exist to hide. In the cellar the tint costs nothing, because masonry is
  ; laid on cell boundaries and the grid is already on show; in a wood it undoes
  ; the art. What says "you cannot walk here" out of doors is the tree itself, and
  ; at the edge of a terrace it is the wall above.
  StoreyShadePercent = 108
  ; Green in the dark, because everything here grows.
  FogTint = 0x060B06
  Tones = [
    Tone
      Name = Wooded
      Floor = models/tiles/forest/floor.gltf
      Wall = models/tiles/forest/tree.gltf
    End
    Tone
      Name = Stony
      Floor = models/tiles/forest/floor_rocky.gltf
      Wall = models/tiles/forest/tree_round.gltf
    End
  ]
  Monsters = [
    ThemeMonster
      Name = Pillar
      Model = models/props/forest/tree_bare.gltf
      ModelScale = 3.5
    End
    ThemeMonster
      Name = Statue
      Model = models/props/forest/rock.gltf
      ; A boulder about as wide as the Statue template is round, so what you see and
      ; what you walk into are the same stone.
      ModelScale = 6.5
    End
    ThemeMonster
      Name = Barrel
      Model = models/props/forest/rock_small.gltf
      ModelScale = 9.0
    End
    ThemeMonster
      Name = Chest
      Model = models/props/forest/chest.gltf
      ModelScale = 5.0
    End
  ]
End
