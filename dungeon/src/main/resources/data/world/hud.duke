; ---------------------------------------------------------------------------
; The hero's panel.
;
; The client draws it — stone slots, a blood bar, a green one — but writes none
; of the words on it, because which language a dungeon speaks is the dungeon's
; business and client3d is shared with three other games. So the wording is here.
;
; RankSuffix is stuck straight onto the level, and onto the level an ultimate is
; waiting for: 7 + "-daraja" is what appears beside his name, 5 + "-daraja" is
; what appears on the locked slot.
;
; The hero's name itself is not here — it is DisplayName in his template, where
; every other name in the game already lives.
; ---------------------------------------------------------------------------
Hud
  DepthWord = CHUQURLIK
  RankSuffix = -daraja
  ; The heading over the skill row and over his bag.
  SkillsWord = MAHORAT
  ; What an unspent level is called, beside the heading above.
  PointsWord = NUQTA
  ; What a slot with nothing left to buy says, and one nobody has bought yet.
  MasterWord = USTA
  ; The tooltip's rows and its footer. Every one of them a finished word, because
  ; the client serves three other games and writes none of its own.
  DamageWord = Zarar
  CooldownWord = Kuluar
  RadiusWord = Radius
  RangeWord = Masofa
  BoostWord = Kuch
  SecondsWord = s
  ; The three things the footer can say: spend one, nothing left to spend it on,
  ; nothing to spend.
  ; The foot of a card that may be raised reads "<RaiseKeyWord><letter> · <RaiseWord>"
  ; -- Ctrl+Q · 1 nuqta sarflanadi. The letter is the skill's own and is put in
  ; by the game, since only it knows which key the skill sits on.
  RaiseKeyWord = Ctrl+
  RaiseWord = 1 nuqta sarflanadi
  MaxedWord = Eng yuqori daraja
  NoPointsWord = Nuqta yo'q
  LockedWord = yopiq
  ItemsWord = NARSALAR
  ; What he is, under his name. A name says which hero; this says what he does.
  HeroTitle = O'q ustasi
  ; The drawing that stands in the portrait when the player has picked out
  ; something that is not his. An archer's silhouette on a skeleton's card would
  ; be the panel lying about what is selected.
  MonsterFace = skull
  ; The four orders on the buttons beside the map, drawn in that order. They are
  ; what a mouse already does; the buttons are there so a player can see that the
  ; orders exist, which a right-click never told him.
  CmdMoveWord = Yur
  CmdAttackWord = Hujum
  CmdStopWord = To'xta
  CmdGuardWord = Himoya
  ; And the screen before the game starts, where he chooses who to be. The roster
  ; on it is the file's — one row per Hero block — so a third hero appears
  ; there by existing. There is no way past it: a run begins by taking a row.
  ChooseHeroWord = QAHRAMONNI TANLANG
  ChooseHeroHint = YUQORI PAST tanlang    ENTER kirish    ESC ortga
  ; Before that, which of the two games. The endless descent is what this has
  ; always been; a stage is the same rooms every time, so that losing teaches
  ; something. If no stage can be played, this screen is skipped entirely and
  ; the hero screen is the whole question — see Stages.all.
  ChooseModeWord = QANDAY O'YNAYSIZ
  ChooseModeHint = YUQORI PAST tanlang    ENTER tanlash    ESC ortga
  EndlessWord = Cheksiz tushish
  EndlessBlurb = Har safar yangi qavat. Qanchaga tushasiz?
  StagesWord = Bosqich
  StagesBlurb = O'zgarmaydigan xarita. Yutqazish o'rgatadi.
  ; And the list itself. The rows are the maps' own names and descriptions, read
  ; from the head of each map's file -- drop a map folder in maps/ and it is on
  ; this screen.
  ChooseStageWord = BOSQICHNI TANLANG
  ChooseStageHint = YUQORI PAST tanlang    ENTER tanlash    ESC ortga
  ; The figures beside his attributes. What they are worth is worked out from the
  ; creature file and his level; what they are CALLED is here, with the rest of
  ; the words. Speed is a figure only on a creature's card: a hero's is what one of
  ; his attributes became, and it is read on that attribute's card -- SpeedNowWord.
  AttackWord = Zarba
  ArmourWord = Zirh
  SpeedWord = Tezlik
  ; What an attribute's card says while the cursor rests on it. The attributes' own
  ; words and pictures are in their Attribute blocks.
  HealthWord = Jon
  PrimaryWord = Asosiy atribut
  EachPointWord = Har bir birlik beradi:
  SpeedNowWord = Hozirgi tezlik:
  ; What a skill's price is called on its card. The bar it comes out of has no
  ; word on it -- a bar with a figure in it and a colour of its own does not need
  ; telling apart from the two above it.
  ManaWord = Mana
  ; ★ AND THESE ARE PAINTED, which is the one thing the panel has to be told
  ; about a picture. It tints what it draws -- that is how ONE white drawing
  ; served a slot that is ready, one reloading and one locked, three colours of
  ; the same file. A painted picture cannot take it: multiply a blue frost burst
  ; by the torch colour and it is a gold frost burst, and the grey blades of the
  ; whirlwind come out brass.
  ;
  ; Saying Yes here leaves the hue alone and tells the states in BRIGHTNESS
  ; instead -- ready is the picture as it was drawn, reloading the same picture
  ; darker, locked darker still and half faded. The armed slot keeps its colours
  ; entirely: the rim, the stone and the brackets round it have already gone
  ; cold, and washing a fire arrow in cyan would make the one socket that matters
  ; the one you cannot read.
  PaintedSkillIcons = Yes
  ; The four order buttons and the four figures: flat
  ; gold on transparency, so these ARE tinted -- gold when they are his, cyan
  ; while one is armed, grey when the creature is not his to order.
  ; Which picture goes on which button. In the file rather than in the client,
  ; which used to hold a drawing per name and so had an opinion about what an
  ; order looks like.
  CmdMoveIcon = icons/commands/cmd_move.png
  CmdAttackIcon = icons/commands/cmd_attack.png
  CmdStopIcon = icons/commands/cmd_stop.png
  CmdGuardIcon = icons/commands/cmd_guard.png
  ; And beside each figure. Named next to the figure rather than counted off
  ; against it: the panel used to pick by position out of a list of its own, so a
  ; game's third figure was a lightning bolt whatever the game thought it was.
  AttackIcon = icons/stats/stat_attack.png
  ArmourIcon = icons/stats/stat_armor.png
  SpeedIcon = icons/stats/stat_speed.png
  ; How often the live portrait is redrawn — see Portrait below. A ceiling
  ; rather than a target: at this it still breathes, and the frames in between
  ; cost nothing at all, because a viewport that is switched off is skipped
  ; before anything in it is touched. Redrawing 150 pixels of one creature on
  ; every frame of a game that is drawing a floor is work nobody can see.
  PortraitFps = 24

  ; ---------------------------------------------------------------------------
  ; The live portrait — what stands in the panel's frame.
  ;
  ; Warcraft's portrait is not a picture. It is a small scene: the hero's own model
  ; with a camera up close to his face and his own animation running in it, which is
  ; the whole of why it reads as a person rather than as an icon. The frame used to
  ; hold a drawn silhouette, and that answered "which corner of the screen is mine";
  ; it could not answer "how is he doing", which is the question a player is
  ; actually asking of it between one click and the next.
  ;
  ; Portrait here is the one EVERY SELECTABLE creature gets, and it is almost
  ; all of this feature: a skeleton, a boss and whatever is added next each get a
  ; properly framed face out of it, with no block of their own. A Portrait in a
  ; creature's own Hero or Monster block overrides it for that creature.
  ;
  ; The frame follows whatever is SELECTED, and "selectable" is the gate — an arrow,
  ; a chest and a barrel all have models and none of them is ever what the bar is
  ; describing.
  ;
  ; NO ART IS NAMED HERE. The model, its scale and the libraries the clips come out
  ; of are in the creature's own block, under the same name. A portrait that named
  ; its own model could drift out of step with the creature it is the face of.
  ;
  ; ---- the camera ----
  ;
  ; Measured in FRACTIONS OF WHAT IT IS LOOKING AT, never in world units — which is
  ; what lets one block frame the whole bestiary. Creatures are whatever size their
  ; kit made them, and a camera in world units would sit in one's chest and a metre
  ; over another's head.
  ;
  ;   Head   how far up it the camera looks. 1 is the top of it
  ;   Show   how much of its height fills the frame. 0.5 is its top half
  ;   Yaw    degrees round it. 0 is dead ahead — its own authored forward, so this
  ;          means the same thing for every kit whatever Facing says
  ;   Pitch  degrees ABOVE it, looking down. Negative looks up at it, which flatters
  ;   Fov    the lens. Narrow flatters a face, wide bends it outward — and it does
  ;          NOT change how much is in the frame, because Show says that outright
  ;
  ; The height is HOW FAR ITS TOP IS OFF THE GROUND, measured off the model, not how
  ; tall its box is. The two differ on anything that does not stand on its feet: the
  ; Stalker and the Reaper are modelled with something trailing below the floor they
  ; hover over, so their boxes are 3.05 tall where they stand 2.17 — measured by the
  ; box, the camera looks a third of a body too low on exactly those two.
  ;
  ; These numbers are measured off this kit, whose characters are drawn with a head
  ; nearly half their height: the head joint sits at 0.55 of the model and the top of
  ; the hair at 1.0, so a camera at 0.86 looks at the FOREHEAD. 0.74 is the face.
  ;
  ; ---- the states ----
  ;
  ; The five states are the CLIENT's — it decides what a state IS, and therefore
  ; whether its clip loops. Calm, Fight and Hurt go round; Dead and LevelUp play once
  ; and the frame keeps the pose they end on.
  ;
  ; A state with no clip named falls back to THE CREATURE'S OWN: its walking-about
  ; idle for standing, its death for dying. Which is why the block below names none
  ; and every monster in the game still breathes in the frame and falls over in it.
  ; Fighting and being hurt fall back to standing rather than to a creature's attack
  ; clip on purpose: an attack is one blow, and looped it is a monster shadow-boxing.
  ;
  ; A clip the model does not carry falls back to standing and says so once in the
  ; log, so a misspelling costs a line rather than a frozen frame.
  ; ---------------------------------------------------------------------------
  Portrait = PortraitArt
    Head = 0.74
    Show = 0.64
    Yaw = 22
    Pitch = -4
    Fov = 34
    ; Below a third of its health it is in trouble, which is the moment the frame is
    ; really for. There is no tired clip in the kit, so speed says "labouring"
    ; without one.
    HurtBelowPercent = 30
    HurtSpeed = 1.5
  End
End

; ---------------------------------------------------------------------------
; The bar over a creature's head
;
; Read at the edge of the eye while the player is aiming somewhere else, which
; is the whole brief: it has to say how dangerous a thing is BEFORE it is looked
; at. Three things do that, and each answers a different question.
;
;   LENGTH   how much it has altogether -- a boss's bar is long, a rat's short
;   MARKS    how much each division is worth, shared by every creature alive
;   COLOUR   whose it is, and whether it is the floor's boss
;
; ★ THE MARKS ARE THE POINT OF THE TABLE. A player who has counted one monster's
; bar can read the next one without counting, because both are divided in the
; same lots. Scale the divisions to each creature's own maximum instead and every
; bar looks identical -- twelve marks on everything, and twelve marks that mean
; nothing.
;
; ★ AND THE LENGTH IS **NOT** WORKED OUT FROM THE MARKS. It is tempting: marks x
; a fixed spacing makes the two agree by construction and is one rule instead of
; two. It inverts. Ninety health at ten a mark is nine marks; a hundred and
; seventy at twenty-five a mark is six -- so the weaker monster would have worn
; the longer bar. Two rules, and the marks are allowed to sit closer together on
; some bars than on others. See UnitBarLookTest, which walks the whole range.
; ---------------------------------------------------------------------------
UnitBar

  ; ---- how much each mark is worth ----
  ;
  ; "<health up to>:<what one mark is worth>", coarsest last. The final rung is
  ; written with * and covers everything above: a creature bigger than anything
  ; planned for still gets marks rather than none.
  ;
  ; ★ THE RUNGS ARE CHOSEN SO THE COUNT STAYS BETWEEN 8 AND 20. Eight because
  ; fewer than that is not a scale, it is four blocks; twenty because past it the
  ; marks are closer together than they are wide and the bar reads as texture.
  ; That fixes the arithmetic completely: a rung covering health from LO to HI in
  ; lots of V needs HI/V <= 20 and LO/V >= 8, which is possible only while
  ; HI <= 2.5 x LO. So every rung below steps up by two or two-and-a-half, never
  ; more, and that is why there are nine of them rather than seven.
  ;
  ; ★ MEASURED AGAINST WHAT THE GAME ACTUALLY MAKES, not against a round range.
  ; The smallest monster has 30 health and the largest is the
  ; Champion, who at the deepest floor carries 600 x 2.2 = 1320; the Knight
  ; reaches 1260 at level fifteen. Everything from 30 to 20000 lands inside 8-20
  ; marks -- checked by DungeonUnitBarTest, which loads this file and walks it.
  Segments = [40:2, 100:5, 200:10, 500:25, 1000:50, 2000:100, 5000:250, 10000:500, *:1000]

  ; ---- how long ----
  ;
  ; The two anchors, in health, and the two lengths, in interface pixels. Between
  ; them the bar grows LOGARITHMICALLY, not proportionally: the range above is
  ; forty-six-fold, and a proportional bar spends nine tenths of it inside its
  ; first quarter-inch -- every monster in the game a stub, and only the boss
  ; visibly longer. The eye compares two bars as a ratio, so the curve is the one
  ; that matches. Doubling a creature's health moves its bar the same distance
  ; wherever it started.
  ;
  ; Outside the anchors it is flat, which is also the answer to "what about a
  ; creature nobody planned for": the weakest thing still has something to look
  ; at, and the strongest cannot draw a bar across the screen.
  ShortestAt = 30
  LongestAt = 2000
  ; Seven tenths of the 95 and 215 they were, which read as too long on screen. Both
  ; ends are cut alike, so every bar is cut alike and keeps its place against the rest.
  Shortest = 66.5
  Longest = 150.5

  ; ---- how tall ----
  ;
  ; ★ THIS IS THE TROUGH, and the dark keyline stands OUTSIDE it -- so a bar on
  ; screen is this plus four. Thirteen looked right on paper and came out at
  ; seventeen against a thirty-four pixel disc, which is half the medallion and
  ; reads as a plank rather than as a gauge. Eight puts the whole thing at twelve,
  ; which is the design's proportion.
  ;
  ; The reading still sits inside it -- that is what took the numbers off the top
  ; of the creature's head, where they fought with its name -- but only just, so
  ; CountSize below moved down with it.
  Height = 8
  ; The mana bar under it, thinner on purpose: it is the second thing to look at,
  ; and a bar of equal weight would argue with the first. Set to 0 and no
  ; creature is drawn one -- which is what every other game this client serves
  ; wants. Drawn only where a creature has mana at all, so a skeleton takes up no
  ; more room than it did.
  ManaHeight = 4
  Gap = 2
  ; How far above the creature's own measured height the whole thing floats, in
  ; world units, before any of it is projected onto the screen.
  Lift = 1.4

  ; ---- the medallion at the near end ----
  ;
  ; The level, in a disc, with the experience ring around it. The number is on
  ; EVERYBODY: a monster's level is the depth it is fought at -- which is exactly
  ; what it is scaled by, see MonsterHealthPercentPerDepth, and what a stage's
  ; difficulty means, see Stage -- so the disc answers "how hard is this one"
  ; with the same number the simulation used to make it hard.
  ;
  ; The RING is only on the hero, because he is the only thing in the game that
  ; earns experience. An empty ring on a skeleton would be a promise that it
  ; could fill.
  Ring = 34
  RingEdge = 2
  RingGap = 5
  Arc = 3

  ; ---- colours ----
  ;
  ; The panel's own, so the bar and the card under it are the same game.
  ; ★ THE ALLY'S FILL IS GREEN AND THE RING IS JADE, and they are deliberately
  ; not the same colour. The fill answers "how much is left"; the ring answers
  ; "how strong is this". One colour for both would tie two questions together
  ; that a player asks at different moments.
  Enemy = 0xB8372C
  Friend = 0x4FA83C
  Mana = 0x3E6FA8
  ; Behind an unfilled bar, and the marks across the filled part. Both nearly
  ; black: the marks are a ruler, and a ruler that competes with the reading is
  ; in the way of it.
  Trough = 0x1A1210
  Tick = 0x0A0806
  RingFace = 0x0A0806
  RingRim = 0x8FC4AE
  ; ★ The one thing on the bar meant to be NOTICED rather than read. Torch, like
  ; every other "this matters" in the game, and it is the whole of how a boss is
  ; told apart at a glance.
  BossRim = 0xE8A33D
  ; A boss is torch-lit throughout -- its rim AND its name -- so BossRim is the
  ; whole of "this is the floor's boss" and there is no second colour to keep in
  ; step with it.
  Lettering = 0xD9CFBA

  ; ---- lettering ----
  NameSize = 12
  ; A boss's name is larger for the same reason its rim is a different colour.
  BossNameSize = 13
  CountSize = 8
  LevelSize = 14
End

; ---------------------------------------------------------------------------
; How the attributes are shown: the block under the hero's experience bar, laid
; out the way Warcraft III lays out a hero. What he hits for and what he shrugs
; off down the left, in the biggest sockets; his PRIMARY large and framed in the
; middle with its value under it; and every attribute above stacked down the
; right, his primary in the brighter gold and the rest dimmer. Green beside a
; value is what he found.
;
; Sizes are design pixels -- the pixels the whole panel is drawn in and scaled
; from. The block keeps room for FigureRows and AttributeRows rows; a game that
; sends more gets them closed up to fit rather than spilling under the stone.
; A Colour sets a word; a Tint multiplies a picture, and 0xFFFFFF is a picture
; exactly as it was drawn.
; ---------------------------------------------------------------------------
StatBlock
  FigureIcon = 30
  PrimaryIcon = 44
  AttributeIcon = 24
  IconShare = 0.8
  RowGap = 2
  GapUnderBar = 6
  FigureColumn = 150
  PrimaryColumn = 74
  FigureRows = 2
  AttributeRows = 3
  FigureText = 12
  AttributeText = 11
  PrimaryText = 14
  LabelColour = 0x8B8171
  ValueColour = 0xD9CFBA
  PrimaryColour = 0xF0D48A
  AttributeColour = 0xC9A24B
  GainColour = 0x7FBF6A
  FrameColour = 0xF0D48A
  FigureTint = 0xC9A24B
  PrimaryTint = 0xFFFFFF
  AttributeTint = 0xC9A24B
End

SkillRing
  ; Thin enough to be a line, thick enough to survive being far away.
  BandWidth = 1.6
  ; How many straight pieces the circle is really made of.
  Segments = 96

  ; The wash inside is there to say "inside", not to hide the floor.
  FillAlpha = 0.10
  EdgeAlpha = 0.85

  ; Clear of the floor, like every other flat mark. A hair above the order mark
  ; so the two never fight for the same pixels when a click lands in a ring.
  Height = 0.3

  ; The only movement left. It opened out and turned slowly to begin with, which
  ; is what the genre does and which was wrong here: an indicator is a ruler, and
  ; a ruler that is still settling is a ruler you have to wait for. It appears at
  ; its size and stands still. The breath is what keeps it reading as live rather
  ; than painted on -- set PulseDepth to 0 for a ring that does not move at all.
  PulseDepth = 0.25
  PulsePerSecond = 1.4

  ; A skill that only touches the caster has no reach to draw, so the ring has to
  ; be some size -- and the size that says "only me" is HIS size and barely more.
  ; His body is 4 across, so this is a ring drawn against him. Anything larger
  ; reads as an area, which is the one thing it is not.
  SelfRadius = 5

  ; Added rather than blended, so over 1 is what lets it read through torchlight.
  Brightness = 1.5

  ; ★ THE SAME CYAN THE ARMED SLOT IS DRAWN IN, so the panel and the floor say
  ; the same thing in the same word: cyan means "you are choosing where this
  ; goes". It used to be a blue on the floor and gold on the bar, which is two
  ; languages for one moment -- and the gold was worse than merely different,
  ; because gold is the bar's own colour and an armed slot drawn in it says
  ; "slightly more gold than usual".
  ;
  ; Cold on purpose. Everything down here is stone, torch and gold, all of them
  ; warm; a cold colour has nothing to blend into.
  ;
  ; Red is still "this will not work" -- it is the one thing that must not be
  ; mistaken for the rest, so it keeps a colour of its own.
  AllowColour = 0x35D6AE
  DenyColour  = 0xFF4436
  ; The blast, a shade off the reach ring rather than a different colour: it is
  ; part of the same aiming and reading it as a warning was the old amber's
  ; doing.
  AreaColour  = 0x9BFFE8
End

; ---------------------------------------------------------------------------
; The flash that answers a click.
;
; Three arrowheads set a third of a turn apart, points inward, closing on the
; spot and going out as they arrive. It is the only thing in the game that talks
; back to the player in the moment between his click and anything happening, so
; it is worth more care than its size suggests: the shape says WHERE by aiming at
; it from three sides, and the movement says NOW without lasting long enough to
; clutter a fight.
;
; Three of these numbers do nearly all the work, and all three look like fussing
; until you have seen them wrong:
;
;   EasePower  -- arrowheads closing at a constant speed read as machinery. Real
;                 things arrive: fast at first, slowing as they land.
;   FadeFrom   -- fading from the first frame gives a mark that is half gone
;                 before it has said anything. It should travel at full strength
;                 and go out over the last stretch.
;   SpinDegrees-- a few degrees over the whole flight. Nobody consciously sees
;                 it; everybody notices the absence of it.
;
; Tune by eye -- nothing here needs a rebuild.
; ---------------------------------------------------------------------------
OrderMark
  ; A cell is 10 across and the hero is 4 wide, so this opens about a room's
  ; doorway and closes to roughly his own footprint.
  StartRadius = 7
  ; Not zero, or the last frame is three shapes on top of each other.
  EndRadius = 1

  ; Short. Long enough to read across a lit room, gone before the next click.
  Seconds = 0.40

  ; One arrowhead: point to back edge, and across the back.
  Size = 3.5
  Width = 3.0

  ; Clear of the floor it is drawn on and not visibly above it. Any lower and it
  ; fights the floor for the same pixels; any higher and it hovers.
  Height = 0.25

  ; 1 is a straight line and looks mechanical; 3 is about right.
  EasePower = 3.0
  ; Full strength for the first 60% of the flight, out over the last 40%.
  FadeFrom = 0.6
  ; Small on purpose. This is life, not a pirouette.
  SpinDegrees = 22

  ; Drawn additively, so over 1 is what lets it read through torchlight and fog
  ; without being a lamp. Past about 2.5 it stops being a colour and goes white.
  Brightness = 1.6

  ; An order given TO SOMEBODY is not the same answer as an order given to a
  ; piece of floor, so it is not the same picture. The arrowheads say "there";
  ; a creature needs "THAT ONE", and arrowheads closing on something that is
  ; about to walk out from under them say it badly. So an attack is a ring round
  ; the creature that goes hard on and hard off -- the oldest way of picking one
  ; thing out of a crowd of them, and still the one the eye finds fastest. A
  ; gentle fade in the middle of a fight is a thing nobody sees.
  ;
  ; Two blinks: one reads as a glitch, three reads as a warning light.
  RingRadius = 7
  Blinks = 2

  MoveColour = 0x3CFF6E
  AttackColour = 0xFF4436
End

; ---------------------------------------------------------------------------
; The numbers that come off a creature as it is hurt or healed.
;
; They punch rather than drift: large on the spot, shrinking to their own size,
; then gone -- the eye catches the change of size without following anything.
; Several landing at once burst out along a fan of directions from the same
; point, so they can be told apart. Seconds is short on purpose: a number still
; up when the next blow lands is in the way of the thing it announces.
; ---------------------------------------------------------------------------
HitNumbers
  Seconds = 0.4
  ; How much bigger than its settled size it appears; the whole movement is
  ; this coming back to 1.
  PopScale = 2.1
  TextScale = 0.85
  ; How far out it bursts, in pixels, and how widely the directions fan either
  ; side of straight up.
  Spread = 34
  FanDegrees = 38
  ; Over the creature's head, in world units, rather than at its feet.
  Height = 14
  ; A trickle of regeneration one point at a time is not news.
  LeastWorth = 1
  ; What he deals, what he takes -- the one he has to notice -- and healing.
  HurtColour = 0xFFE0A0
  TakenColour = 0xC22A22
  HealColour = 0x4FBF4F
  Brightness = 1
End

; ---------------------------------------------------------------------------
; The lettering the menus are set in, and the stone they are cut from.
;
; Carved Roman capitals, baked from the TTF into a page of glyphs and a table by
; BitmapFontBaker — jME cannot read a TrueType font. Named here rather than in
; the client because the client draws four games and none of the others is a
; dungeon.
;
; Naming no font puts the menus back to the engine's own plain lettering; leaving
; a colour out gives it the one below, which is this dungeon's.
;
; The shapes are the client's -- a slab, a lit line, a bar, an arrowhead -- and
; the colours are not: these are the same three the bar is lit by (stone, torch,
; bone), so a game that re-tints one re-tints the other and the two never drift.
; ---------------------------------------------------------------------------
MenuStyle
  TitleFont = fonts/cinzel-22.fnt
  RowFont = fonts/cinzel-17.fnt

  ; A slab: its face from the lit top down to the foot, the lip along its top
  ; edge, and the shadow under it.
  StoneDeepColour = 0x16130F
  StoneColour = 0x2B2620
  StoneLitColour = 0x3D362C
  StoneEdgeColour = 0x5A5042
  SlabFootColour = 0x0A0806
  ; What is behind a menu: dark at the top and the foot, warmer across the middle
  ; where the two torches are.
  GloomTopColour = 0x0C0A08
  GloomMiddleColour = 0x241E19
  ; And what the world under a menu is washed with, and how heavily.
  VeilColour = 0x080605
  VeilPercent = 78

  ; The torch a menu is read by; the same, hotter, for the row the hand is on.
  TorchColour = 0xE8A33D
  TorchHotColour = 0xFFD089
  BoneColour = 0xD9CFBA
  ; Quitting and giving up are the only rows drawn in blood.
  BloodColour = 0xA8322B
  MuteColour = 0x7A7062
  HintColour = 0x8B8171
  RuleColour = 0x3A322A
  DangerLitColour = 0xE08A80
  RowColour = 0xA69B87
  GrooveColour = 0x2A241D
  DimColour = 0x5A5346
  QuietColour = 0x5D5548
  ; A setting that is on, and the filled part of a slider.
  OnTopColour = 0x4A3A1E
  OnFootColour = 0x2E2413
  FillTopColour = 0xF0BC6B
  FillFootColour = 0xA06D1F
  FootnoteColour = 0x443E35
End

; ---------------------------------------------------------------------------
; What the mouse pointer looks like, and over what.
;
; The pointer used to be the operating system's white arrow, which says exactly
; as much over a skeleton as over a wall: nothing. Half of the controls in a
; game played with a mouse are "the right-click means something different here",
; and the pointer is the only place that can be said BEFORE the click.
;
; The situations are the client's, because what is under the pointer is a fact
; about the screen rather than about the world -- a unit, the bar, a skill
; waiting to be aimed. There are five and the client knows no others:
;
;   Point   nothing in particular: open ground, the bar, a menu
;   Friend  one of his own
;   Attack  something a right-click would set about
;   Aim     a skill is armed and this is somewhere it can go
;   Deny    a skill is armed and this is not
;
; HotX and HotY are where the tip of the pointer is IN THE PICTURE, counted from
; its top-left corner the way anyone looking at the file would count. Get them
; wrong and every click lands a little away from where it was aimed, which reads
; as the game being imprecise rather than as two numbers being wrong. These
; drawings all put the arrow's point in the top-left corner, so they are all the
; same pair.
;
; Delete a block and that situation keeps whatever pointer was last shown;
; delete them all and the game is back to the system arrow.
; ---------------------------------------------------------------------------

; Tint is what colours them. The drawings are WHITE SHAPES INSIDE A BLACK
; OUTLINE, and the tint is multiplied in rather than painted over: white becomes
; the colour, black stays black, and the grey along an anti-aliased edge comes
; out as a darker shade of the same colour. So a tinted pointer is a coloured
; arrow that keeps its black keyline -- which is the thing that lets it be read
; against a dark floor and a lit wall alike. Painting over the drawing instead
; would flood the outline too and leave a shape with no edge.
;
; 0xFFFFFF means "as drawn", and costs no arithmetic at all.
;
; The colours below are the panel's, so the pointer and the bar are the same
; game: bone for nothing in particular, green for his, blood for a fight, torch
; for a skill waiting to be aimed.
;
; ui/cursors/ holds two sizes of the same 182 drawings: default/ at 32 pixels and
; double/ at 64. Thirty-two is the ordinary size for a pointer; on a very large
; screen double/ is the same line naming a different folder.
Cursor
  Name = Point
  ; "cursor_none" is the pack's name for the plain arrow -- an arrow with no
  ; badge on it, not the absence of a cursor.
  Image = ui/cursors/default/cursor_none.png
  HotX = 8
  HotY = 3
  Tint = 0xDCD2BC
End

Cursor
  Name = Friend
  ; A pointing hand: this is yours and you can take hold of it.
  Image = ui/cursors/default/hand_small_point.png
  HotX = 8
  HotY = 5
  Tint = 0x7FBF6A
End

Cursor
  Name = Attack
  ; A sword. The one pointer that promises something, so it is only shown over a
  ; thing the next right-click will really set about.
  Image = ui/cursors/default/tool_sword_a.png
  HotX = 2
  HotY = 2
  Tint = 0xC4564A
End

Cursor
  Name = Aim
  ; A crosshair, and the one pointer whose tip is its MIDDLE rather than a
  ; corner -- that is what a crosshair is for, and the numbers say so.
  Image = ui/cursors/default/target_round_a.png
  HotX = 15
  HotY = 15
  Tint = 0xE8A33D
End

Cursor
  Name = Deny
  ; Armed, and this is stone or somewhere he has never been.
  Image = ui/cursors/default/cursor_disabled.png
  HotX = 2
  HotY = 1
  Tint = 0xA8322B
End

; ---------------------------------------------------------------------------
; The hero's bar: which blocks it has, in what order, how big its sockets are,
; and every colour it is painted in.
;
; Blocks IS the bar, left to right. Minimap is the map's socket with the order
; buttons beside it; Hero is his portrait, what is left of him under it, and his
; name, experience and figures beside it; then Bag, Skills and Depth. Leave one
; out and the bar closes up where it was -- and without Minimap the map stands
; in the corner over the bar instead.
;
; The sizes are in the pixels the design was drawn at, DesignWidth wide. The bar
; is scaled from there to the window: never smaller than MinScale while it still
; fits, never larger than MaxScale. A socket asked to be bigger than the bar is
; tall is drawn as big as fits, so a bag of five rows is five rows of smaller
; sockets rather than a bag through the floor.
;
; Every colour is 0xRRGGBB. The stone is the field everything is cut into; the
; carved edges laid over it are the Skin blocks below, and are not these.
; ---------------------------------------------------------------------------
PanelLook
  Blocks = [Minimap, Hero, Bag, Skills, Depth]
  ; A block that stands on its own instead, hung from a corner or an edge of the
  ; window on a plate of the same stone:
  ;
  ;   Places = [Minimap TopRight 12 12]
  ;
  ; takes the map off the bar and hangs it twelve pixels in from the top right
  ; corner -- and the bar closes up where it was. The places are TopLeft, Top,
  ; TopRight, Left, Middle, Right, BottomLeft, Bottom and BottomRight (spell them
  ; TOP_RIGHT or top-right if you like), and the two numbers are always measured
  ; INWARDS from what the anchor names, so the same pair means the same distance
  ; at every corner. At Middle they move it right and up from the centre instead.
  ;
  ; A block named here comes off Blocks above: it stands on the bar or on its own,
  ; never both. Hang every block somewhere and the bar itself is not drawn at all,
  ; and the world reaches the bottom of the window.
  Places = []
  DesignWidth = 1300
  MinScale = 0.55
  MaxScale = 1.3

  ItemColumns = 3
  ItemRows = 2
  ItemSlot = 42
  SkillSlot = 58
  ; Drawn proud of the other four, and the one the eye finds without looking.
  UltimateSlot = 64
  UltimateKey = R

  ; The slab, top to bottom, and the lit rim along its top edge.
  SlabTopColour = 0x4A4033
  SlabHighColour = 0x3A3127
  SlabMidColour = 0x2B241C
  SlabLowColour = 0x221C16
  SlabRimColour = 0x6B5C46
  ; A warm grey that catches light. A third darker and every gold edge on the
  ; bar loses the contrast it was chosen for.
  StoneDeepColour = 0x16130F
  StoneColour = 0x332B22
  StoneLitColour = 0x4A4033
  StoneDeadColour = 0x191510
  StoneDeadLitColour = 0x231F1A
  SocketRimColour = 0x453D30
  HoleColour = 0x0C0A08
  EdgeColour = 0x100D0A
  DropColour = 0x0A0806
  PortraitTopColour = 0x4A4034
  PortraitBottomColour = 0x241E17
  PortraitRimColour = 0x5A4E3C
  ItemTopColour = 0x3E3529
  ItemBottomColour = 0x201A14

  ; Torch for what a skill is, blood for health, green for experience, blue for
  ; what he can spend.
  TorchColour = 0xE8A33D
  GoldColour = 0xC9A24B
  GoldHiColour = 0xF0D48A
  GainColour = 0x7FBF6A
  BoneColour = 0xD9CFBA
  BloodColour = 0xA8322B
  ArcaneColour = 0x5F8C7B
  ManaColour = 0x3E6FA8
  ; What the mana bar flashes when he asks for what he has not got, and what a
  ; skill he cannot pay for is washed with.
  ManaDeniedColour = 0xE06A5A
  ManaWashColour = 0x9EC7FF
  DeadColour = 0x4A443B
  GlyphColdColour = 0x6A6154
  PipDarkColour = 0x2A241D
  ; The cold stone a skill waiting for its target is cut from: the one cold
  ; colour on a warm bar, so it has nothing to blend into.
  SelStoneColour = 0x16302E
  SelStoneLitColour = 0x2E4A46
  LabelColour = 0x8B8171
  LockLabelColour = 0x6E6555
  ItemNumberColour = 0x7A7062
  BadgeColour = 0x4A3A18
  FleshColour = 0x6B5B45
  ; Each bag socket's drawing, socket by socket: the client does not know what
  ; a flask is, so it colours by place rather than by picture.
  ItemColours = [0xC4564A, 0x5F8C7B, 0xC9A24B, 0xE8A33D, 0x8FA8C4, 0xB08CC4]
End

; ---------------------------------------------------------------------------
; What the panel's edges are painted with.
;
; The panel was drawn entirely out of flat colour: a lit line along a top edge,
; a darker one under it, and the eye asked to read stone. It reads as neat, and
; neat is not what a dungeon's furniture should look like. So the edges are
; painted from a set of carved frames -- and only the edges.
;
; THE RULE, and the reason it looks right: the picture is the FRAME and never
; the field. What is inside a socket stays the gradient it always was, and the
; picture -- white line-work on nothing -- is laid over the top and tinted. That
; is what a carved panel actually is: a shaded surface with a painted edge. The
; same set ships filled versions of every frame, and using one would flatten the
; socket into a single colour, which is worse than what was there before.
;
; Inset is the number that makes one file serve everything. It says how many
; pixels at each edge of the picture are corner, and those pixels are never
; stretched: only the middle of each edge is, along its own length. So a 48-pixel square
; frames a 22-pixel chip and a 190-pixel bar without its corners melting. The
; value is read off the file -- it is the width of the corner motif -- and a
; wrong one shows up at once as either a stretched corner or a fat edge.
;
; Scale is how many panel pixels one picture pixel becomes, which is how the
; same file is laid on lightly for a socket and heavily for something wide.
;
; Tint is the whole palette question: the pictures are white, so this is the
; only thing deciding whether an edge is gold or bone. The panel's own stone
; colours are unchanged -- they are the field, and the field is not painted.
;
; Every one of these is optional. Delete a block and that part of the panel is
; drawn the way it was before there were any pictures; delete them all and the
; panel is exactly the one the game shipped with. A name that is not one of
; Minimap, Portrait, Slot, Gauge, Chip, Button, Item, Divider, Banner, BannerWon
; or BannerLost is said in the log and ignored, for the same reason.
; ---------------------------------------------------------------------------
Skin
  Name = Minimap
  ; Heavy Greek-key corners. The map is the busiest square on the bar and wants
  ; the firmest edge round it.
  Texture = ui/borders/default/border/panel-border-016.png
  Inset = 16
  Scale = 1.15
  Tint = 0xC9A24B
End

Skin
  Name = Portrait
  ; Corner brackets, which is what this frame already had drawn in lines. The
  ; picture is the same idea carved rather than ruled.
  Texture = ui/borders/default/border/panel-border-000.png
  Inset = 10
  Scale = 1.2
  Tint = 0xC9A24B
End

Skin
  Name = Slot
  ; One picture for the four skill sockets AND the larger ultimate: the whole
  ; point of an inset is that the ultimate is the same frame drawn bigger, with
  ; corners that stay the size they were carved at.
  Texture = ui/borders/default/border/panel-border-013.png
  Inset = 10
  Scale = 1.1
  Tint = 0xC9A24B
End

Skin
  Name = Gauge
  ; The plain square, whose whole ornament is a two-pixel rule. A health bar
  ; wants a bezel and nothing else -- anything carved would be read as part of
  ; the reading.
  Texture = ui/borders/default/border/panel-border-015.png
  Inset = 2
  Scale = 1.5
  Tint = 0x8A7F6C
End

Skin
  Name = Button
  ; The four order buttons. Small and plain: they sit beside the map and must not
  ; compete with the skill row, which is the thing a player looks at in a fight.
  Texture = ui/borders/default/border/panel-border-011.png
  Inset = 10
  Scale = 0.85
  Tint = 0xC9A24B
End

Skin
  Name = Item
  ; His bag. A quieter frame than a skill socket, and bone rather than gold:
  ; what he is carrying is worth seeing and never worth looking at first.
  Texture = ui/borders/default/border/panel-border-019.png
  Inset = 12
  Scale = 0.8
  Tint = 0x8A7F6C
End

Skin
  Name = Chip
  ; Twenty-two pixels square, so the frame is nearly all corner. A simple one.
  Texture = ui/borders/default/border/panel-border-011.png
  Inset = 10
  Scale = 0.55
  Tint = 0xC9A24B
End

Skin
  Name = Divider
  ; The odd one. A divider is an ornament of a fixed length rather than a frame,
  ; so it is not cut into nine: it is drawn whole, stood on end, and mirrored
  ; about the middle of the bar. The picture fades at one end and finishes in a
  ; device at the other, so the two faded ends meet in the middle and the two
  ; devices point out. Scale sets how long each half is -- 96 picture pixels at
  ; 0.86 is 83, and two of those very nearly fill the 172-pixel band.
  Texture = ui/borders/default/divider_fade/divider-fade-002.png
  Inset = 0
  Scale = 0.86
  Tint = 0xC9A24B
End

; ---- the plaque a banner is written on ------------------------------------
;
; Three of them rather than one, because the three moments a run has outside the
; fight are not the same news and the frame is the only thing on screen that can
; say which: a death is an interruption, a floor is a door, an ending is an
; ending. Name only "Banner" and all three get that one -- still better than the
; bare lettering this replaced, which was the one readable thing in the game
; with nothing behind it, over a dark floor with a fight on it.
;
; Heavier corners and a bigger Scale than the bar uses: this is read once, from
; the middle of the screen, at four times the interface size.
Skin
  Name = Banner
  Texture = ui/borders/default/border/panel-border-016.png
  Inset = 16
  Scale = 1.8
  Tint = 0xC9A24B
End

Skin
  Name = BannerWon
  ; Gold, and more of it. An ending is the one banner worth looking at.
  Texture = ui/borders/default/border/panel-border-019.png
  Inset = 16
  Scale = 1.8
  Tint = 0xF0C860
End

Skin
  Name = BannerLost
  ; The same red the deny cursor and the attack mark are drawn in, so the colour
  ; means one thing across the whole game.
  Texture = ui/borders/default/border/panel-border-000.png
  Inset = 16
  Scale = 1.8
  Tint = 0xB03A30
End
