; Arriving: light coming down onto him, paler than a level's -- torchlight rather
; than gold -- as though he had been let down into the dark on it. The ring opens
; when the light reaches the floor, which is a fifth of the way through the core.
Effect
  Name = Descent

  Layers = [
    Layer
      Name = Ring
      Type = RING
      Texture = effects/particles/circle_02.png
      Blend = Additive
      Count = 1
      Delay = 0.12
      Life = [0.5, 0.5]
      Size = [8, 48]
      SizeEase = 3
      Colour = [0xFFF2D8, 0xFFB870]
      ColourEase = 2
      Alpha = [0.85, 0]
      FadeOut = 0
      At = CASTER
      Follows = Yes
    End

    Layer
