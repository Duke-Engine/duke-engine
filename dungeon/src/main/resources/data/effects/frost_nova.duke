Effect
  Name = FrostNova
  ; W, and the one that had to be unmistakable: it is his panic button, it is
  ; cast when he is already in trouble, and the player has to be able to read
  ; "it went off, and it caught these" in the quarter second he has.
  ;
  ; So: the coldest colour on the page, the widest fast ring, a real light, and
  ; the strongest wash inside it of anything here -- the wash is what makes the
  ; caught ground read as a floor that just froze rather than as a circle.
  Kinds = [SHOCKWAVE, IMPACT_BURST]
  Colour = 0x9FE8FF
  LightColour = 0x5AC8FF
  LightPower = 2.8
  LightRadius = 72
  BurstParticles = 40
  BurstSize = 3.4
  BurstSeconds = 0.34
  WaveFrom = 3
  WaveTo = 40
  ; Fast: the whole skill is that it happened before they could get out.
  WaveSeconds = 0.34
  WaveEase = 3.2
  WaveEdge = 1.0
  WaveWash = 0.34
  ShakeSeconds = 0.12
  ShakePower = 0.7

  Layers = [
    ; Cold, opening outward: a flash at his feet, a swirl and a hard rim racing out to
    ; the edge of the skill, shards skating low across the floor, a mist that lingers,
    ; frost left on the stone, and a glitter on everything the nova caught.
    ;
    ; The pack has no ice. Stars and swirls tinted pale blue stand in for it, and read
    ; as cold by colour alone -- a proper shard or snowflake would read as ICE.
    Layer
      Name = Flash
      Type = IMPACT
      Texture = effects/particles/star_08.png
      Blend = Additive
      Count = 1
      Life = [0.22, 0.22]
      Size = [10, 44]
      SizeEase = 3
      Colour = [0xF0FCFF, 0x7ED0FF]
      Alpha = [1, 0]
      FadeOut = 0.7
      Height = 3
      TurnJitter = 45
    End

    Layer
      Name = Swirl
      Type = RING
      Measure = Reach
      Texture = effects/particles/twirl_02.png
      Blend = Additive
      Cover = 0.25
      Count = 1
      Life = [0.5, 0.5]
      Size = [0.25, 2.5]
      SizeEase = 3
      Colour = [0xD0F4FF, 0x2A8CFF]
      Alpha = [1, 0]
      FadeOut = 0.55
      Spin = 90
      Height = 0.4
    End

    Layer
      Name = Rim
      Type = RING
      Measure = Reach
      Texture = effects/particles/circle_02.png
      Blend = Additive
      Cover = 0.3
      Count = 1
      Life = [0.38, 0.38]
      Size = [0.2, 3.4]
      SizeEase = 3.5
      Colour = [0xE8FBFF, 0x3AA8FF]
      Alpha = [1, 0]
      FadeOut = 0.5
      Height = 0.5
      TurnJitter = 0
    End

    Layer
      Name = Shards
      Type = BURST
      Texture = effects/particles/star_06.png
      Blend = Additive
      Count = 36
      Life = [0.35, 0.55]
      Size = [2.8, 0.6]
      SizeJitter = 0.4
      Stretch = 0.03
      Colour = [0xF0FCFF, 0x5AB8FF]
      Speed = [60, 110]
      Direction = OUT
      Spread = 20
      Drag = 5
      Height = 2
    End

    Layer
      Name = Mist
      Type = BURST
      Texture = effects/particles/smoke_07.png
      Blend = Alpha
      Count = 12
      Radius = 26
      Life = [0.8, 1.3]
      Size = [12, 24]
      SizeJitter = 0.3
      Colour = [0xDFF4FF, 0xA8D8F0]
      Alpha = [0.45, 0]
      FadeIn = 0.15
      Speed = [6, 14]
      Direction = OUT
      Spread = 10
      Drag = 2.5
      Spin = 20
      Height = 2
    End

    Layer
      Name = Frost
      Type = MARK
      Measure = Reach
      Texture = effects/particles/twirl_03.png
      Blend = Additive
      Cover = 0.35
      Count = 1
      Seconds = 1.5
      Size = [2.2, 2.2]
      Colour = [0xA8E4FF, 0xA8E4FF]
      Alpha = [0.5, 0.5]
      FadeIn = 0.1
      FadeOut = 0.6
      Spin = 25
      Height = 0.3
    End

    ; On whoever the nova caught, for exactly as long as it slows them: no Seconds, so
    ; the skill's own SlowFrames. The client is never told who is slowed, but it is told
    ; who stood inside the nova when it went off, and that is who the simulation slowed.
    Layer
      Name = Caught
      Type = AURA
      Texture = effects/particles/star_04.png
      Blend = Additive
      At = CAUGHT
      Count = 10
      Rate = 10
      Life = [0.5, 0.8]
      Radius = 3
      Height = 3
      Size = [2, 0.4]
      Colour = [0xE8FBFF, 0x7ED0FF]
      Speed = [2, 5]
      Direction = UP
      Spread = 40
      Drag = 1
    End

    Layer
      Name = Chill
      Type = LIGHT
      Seconds = 0.5
      LightColour = 0x6ACBFF
      LightPower = 3.5
      LightRadius = 90
      FadeOut = 0.85
    End
  ]
End
