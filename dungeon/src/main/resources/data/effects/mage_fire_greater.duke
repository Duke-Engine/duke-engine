Effect
  Name = MageFireGreater
  ; The Necromancer's, which is the Revenant's grown. Everything is the same
  ; shape and larger -- the same fire, thrown by something bigger, is what makes
  ; the boss read as the same creature at the end of its own line rather than as
  ; a different monster that happens to be in the last room.
  Kinds = [GLOW_ORB, FLAME_TRAIL, IMPACT_BURST]
  Colour = 0xFF7A2A
  FadeColour = 0x5A0E00
  LightColour = 0xFF6A18
  LightPower = 3.0
  LightRadius = 70
  OrbSize = 2.6
  Particles = 54
  ParticleSize = 5.0
  ParticleLife = 0.55
  Spread = 8
  BurstParticles = 44
  BurstSize = 4.4
  BurstSeconds = 0.42
End
