Effect
  Name = MageFireball
  ; Q. Bigger than anything the monsters throw and lit like it: this is the shot
  ; the player spent a cooldown on, so it is the one worth lighting the room for,
  ; exactly as FlameArrow is for the archer.
  Kinds = [GLOW_ORB, FLAME_TRAIL, IMPACT_BURST]
  Colour = 0xFFC04A
  FadeColour = 0x7A1400
  LightColour = 0xFF7A18
  LightPower = 3.2
  LightRadius = 82
  OrbSize = 2.2
  Particles = 56
  ParticleSize = 4.6
  ParticleLife = 0.58
  Spread = 8
  ; The burst is the SKILL's Radius made visible, so it is the widest one here.
  BurstParticles = 54
  BurstSize = 6.0
  BurstSeconds = 0.45

  Layers = [
    ; In flight: a core that flickers, fire let out behind it, embers thrown off it,
    ; smoke that rises after, and the light it carries across the floor. Then where it
    ; lands, as wide as its blast hurts -- the bloom, the fire, the smoke and the scorch
    ; are measured in the skill's Radius: a flash, fire thrown out to the edge of the
    ; blast, sparks past it, a wave of dust rolling out to it, the ring that marks it,
    ; and a scorch that stays behind.
    Layer
      Name = Core
      Type = AURA
      Texture = effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.35
      Count = 8
      Rate = 40
      Life = [0.12, 0.2]
      Size = [10, 7]
      Colour = [0xFFEBB8, 0xFF9A30]
      Alpha = [1, 0.6]
      Radius = 0.3
    End

    Layer
      Name = Heart
      Type = AURA
      Texture = effects/particles/fire_02.png
      Blend = Additive
      Cover = 0.5
      Count = 12
      Rate = 50
      Life = [0.15, 0.25]
      Size = [11, 6]
      SizeJitter = 0.25
      Colour = [0xFFB040, 0xE04000]
      Alpha = [1, 0]
      Radius = 1
      Spin = 240
    End

    Layer
      Name = Flames
      Type = TRAIL
      Texture = effects/particles/fire_01.png
      Blend = Additive
      Cover = 0.45
      Count = 48
      Rate = 90
      Life = [0.22, 0.4]
      Size = [10, 3]
      SizeEase = 2
      SizeJitter = 0.35
      Colour = [0xFFB347, 0x8A1500]
      ColourEase = 2
      Alpha = [1, 0]
      Speed = [1, 4]
      Direction = ALL
      Drag = 2
      Gravity = -10
      Spin = 120
    End

    Layer
