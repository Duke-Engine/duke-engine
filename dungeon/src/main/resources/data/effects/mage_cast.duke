; ---- the mage ----

Effect
  Name = MageCast
  ; Q at the staff. The ball is the show -- see DungeonEffect MageFireball above,
  ; which is the brightest thing in the game -- so this is only the muzzle: a
  ; small hot ring where it left him.
  Kinds = [SHOCKWAVE]
  Colour = 0xFFB04A
  WaveFrom = 1
  WaveTo = 14
  WaveSeconds = 0.26
  WaveEase = 3.0
  WaveEdge = 0.85
  WaveWash = 0.12

  ; The fireball leaving his hand. A flare rather than a burst: it is the moment of
  ; letting go, and the fire itself belongs to the thing that flies.
  Layer
    Name = Spark
    Type = IMPACT
    Texture = effects/particles/flare_01.png
    Blend = Additive
    Count = 1
    Life = [0.22, 0.22]
    Size = [8, 28]
    SizeEase = 3
    Colour = [0xFFE6B0, 0xFF7020]
    Alpha = [1, 0]
    FadeOut = 0.6
    Height = 6
    TurnJitter = 0
  End

  Layer
    Name = Puff
    Type = BURST
    Texture = effects/particles/fire_01.png
    Blend = Additive
    Cover = 0.4
    Count = 6
    Life = [0.2, 0.3]
    Size = [4, 11]
    SizeEase = 2.5
    Colour = [0xFFC060, 0xB02A00]
    Alpha = [1, 0]
    Speed = [6, 12]
    Direction = ALL
    Drag = 4
    Spin = 90
    Height = 6
  End

  Layer
    Name = Motes
    Type = BURST
    Texture = effects/particles/star_04.png
    Blend = Additive
    Count = 10
    Life = [0.25, 0.4]
    Size = [1.4, 0.2]
    SizeEase = 2
    Colour = [0xFFD080, 0xFF5010]
    Speed = [8, 16]
    Direction = ALL
    Drag = 3
    Height = 6
  End

  Layer
    Name = Light
    Type = LIGHT
    Seconds = 0.25
    LightColour = 0xFF9040
    LightPower = 2
    LightRadius = 40
    FadeOut = 0.8
  End
End
