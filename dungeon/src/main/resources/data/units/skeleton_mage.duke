; The one that casts. Frail, slow, and dangerous only at a distance: between its
; fireballs it throws the Revenant's small fire, and the fireball is a skill its
; brain decides to throw -- see Monster SkeletonMage and Skill
; SkeletonMage Q below.
Monster
  Name = SkeletonMage
  DisplayName = Skeleton Mage
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 13
  End
  VisionRange = 64
  Modules = [
    GrowableBody
      MaxHealth = 40
    End
    MoveUpdate
      ; Slower than any hero, so the one it is backing away from can catch it.
      Speed = 13
      TurnRate = 0
    End
    ; Its ordinary fire, for while the fireball comes back: weak, and reaching the far
    ; edge of the band it keeps (KeepDistance 35 55), so it is never standing about.
    WeaponUpdate
      Damage = 6
      AttackRange = 58
      ReloadFrames = 54
      AttackOnTheMove = No
    End
    ; That it has skills. Which ones is its Skill blocks' business, below.
    SkillBook
    End
    ; Before the Bow, because a shot goes to the first launcher that takes it. Swing
    ; only notes the frame and passes it on, which is how the brain knows a throw is
    ; still leaving and holds its fireball until it has.
    Swing
    End
    ; The Revenant's small fire, which has to get there.
    Bow
      Projectile = Fireball
      Speed = 95
      MuzzleOffset = 8
    End
    ; And only at what it can see.
    EyesOnly
    End
    StatusUpdate
    End
    MonsterBrain
    End
    ExperienceModule
      ExperienceValue = 20
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; The first thing down here that decides for itself. It keeps him at a distance
  ; -- further than he can easily reach it, nearer than it can easily miss -- and
  ; throws a fireball whenever he is inside that and in plain sight, and its small
  ; ordinary fire while the fireball comes back. Frail and slow: it is dangerous
  ; only for as long as he lets it stand back there.
  SenseRadius = 64
  ChaseRadius = 120
  ; Unused: it holds the band below rather than closing, and its ordinary fire
  ; reaches the far edge of that band.
  CloseDistance = 6
  AlertRadius = 70
  RepathFrames = 10
  ; How long a throw holds it still -- the fireball or its ordinary fire -- and the
  ; one waits for the other, so each is seen leaving.
  SwingFrames = 20
  MinDepth = 2
  Weight = 10
  ; No more than two to a room, or a room of them is a firing squad.
  MaxPerRoom = 2
  Colour = 0xFF7A3A
  Scale = 1
  ; It throws when he is at least this far and at most this far, surface to surface.
  SkillDistance = [20, 60]
  ; And it holds him between these: nearer and it backs away, further and it comes.
  KeepDistance = [35, 55]
  ; The staff-carrier again, burning: a warm wash tells it from the pale Revenant
  ; before its fire does.
  Model = models/monsters/skeleton_mage.glb
  Animations = Humanoid
  Effect = EmberEyes
  ModelScale = 6.0
  Held = Held
    Model = models/monsters/staff.gltf
    Bone = handslot.r
  End
  Tint = 0xFF9A6A
  Attack = Ranged_Magic_Shoot
  Idle = Ranged_Magic_Spellcasting_Long

  ; ---------------------------------------------------------------------------
  ; A monster's own skill.
  ;
  ; Headed by the creature's name exactly as a hero's are, and cast by its brain
  ; rather than a key -- see Skill, SkillDistance and KeepDistance on its
  ; Monster block. It pays no mana and has one rank: what makes it hit harder
  ; further down is the depth, as for its weapon. ProjectileSpeed is how fast what it
  ; throws travels; unsaid, it would be the hero's HeavySpeed.
  ; ---------------------------------------------------------------------------

  Skills = [
    Skill
      Key = Q
      ; Its fireball: the Mage's own Q, from something that does not want to be near
      ; him. Half as fast as his, so a player who sees it leave the staff can step out
      ; of its line -- and it bursts where it stops, as his does.
      Effect = SKILLSHOT
      ; The one worth stepping out of the way of: its ordinary fire is 6.
      Damage = 45
      Range = 70
      Radius = 16
      HitWidth = 6
      ProjectileSpeed = 60
      Projectile = SkullFireball
      ; Six seconds between fireballs, with its ordinary fire in between.
      CooldownFrames = 180
      MaxRank = 1
      Name = Olov shari
    End
  ]
End
