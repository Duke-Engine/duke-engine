Monster
  Name = Stalker
  DisplayName = Stalker
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 3
    Height = 12
  End
  VisionRange = 98
  Modules = [
    GrowableBody
      ; Frail. It reaches you first; it should not also survive the exchange.
      MaxHealth = 40
    End
    MoveUpdate
      Speed = 16
      TurnRate = 0
    End
    WeaponUpdate
      ; Hits harder than the ordinary one, because it is frail and dies quickly
      ; once anything reaches it.
      Damage = 12
      ; A crossbow. Well short of the hero's 60, on purpose: he should be able to
      ; open the exchange and win it by keeping his distance, and lose it by being
      ; caught in the open at forty units.
      AttackRange = 52
      ; Slow to wind. A crossbow that fired as often as a skeleton swings would
      ; make standing still impossible, which is the hero's whole game.
      ReloadFrames = 70
      ; A crossbow is levelled standing still, like the hero's bow.
      AttackOnTheMove = No
    End
    ; Its bolts leave the crossbow and have to get there -- the same module the
    ; hero's bow uses, saying which projectile of its own it looses.
    Bow
      Projectile = Bolt
      Speed = 150
      ; Out at the crossbow rather than at the middle of the ribcage. Its own
      ; radius is 3, so five left the bolt starting inside it and squeezing out.
      MuzzleOffset = 9
    End
    ; And it shoots at what it can SEE. Not decoration: the engine's weapon knows
    ; nothing about walls, so the first thing down here with a reach worth the name
    ; would otherwise shoot the hero through the stone between them -- which is the
    ; one thing a dungeon must not allow. The hero has carried this since he had a
    ; bow; this is the same rule for the first monster to need it.
    EyesOnly
    End
    ; Tells the brain the frame a blow landed, so it stands and finishes the shot
    ; instead of walking off mid-shot. It launches nothing -- see Swing.
    Swing
    End
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End
    ScriptModule
      Name = StalkerBrain
    End
    ExperienceModule
      ExperienceValue = 18
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; It said here that everything down here fights hand to hand because the kit
  ; had no creature that could plausibly shoot, so this one was a distance closed
  ; rather than a distance kept. The kit has one now, and this is it: the Stalker
  ; is the thing that notices from across the floor and then does something about
  ; it from where it is standing.
  ;
  ; Which changes how the floor is played rather than how it looks. Every other
  ; monster is a problem you can walk away from; this one follows you with bolts.
  SenseRadius = 55
  ChaseRadius = 110
  ; It stops well short and shoots -- inside its own reach of 52, for the reason
  ; the hero's CloseDistance is inside his: stopping at your maximum means parking
  ; on the edge of it, where one step either way puts the target out.
  CloseDistance = 42
  AlertRadius = 70
  RepathFrames = 12
  SwingFrames = 12
  MinDepth = 2
  Weight = 20
  Colour = 0x4FC3A1
  Scale = 0.9
  ; The hooded one, which is what a thing that follows you should look like.
  ; It boxes 3.05 rather than 2.17 -- the hood -- so its scale is the odd one.
  Model = models/monsters/skeleton_rogue.glb
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 3.9
  Held = Held
    Model = models/monsters/crossbow.gltf
    Bone = handslot.r
    ; A quarter turn, because the crossbow is the second weapon in these packs that
    ; is not laid out like the rest of them. The blades, axes and staves all run
    ; along their own +Y and the bone is authored for that; a crossbow runs along
    ; +Z -- as the hero's bow does -- so hung as it came it lay ACROSS the body,
    ; flat and pointing sideways at the floor, which is what a skeleton holding a
    ; crossbow like a tray looks like.
    ;
    ; Ninety degrees about the upright puts its length on the hand's own forward,
    ; which in the aiming pose is where the creature is looking.
    Yaw = 90
  End
  ; Two hands on a crossbow, so it is the two-handed shot rather than the chop
  ; every other thing down here throws.
  Attack = Ranged_2H_Shoot
  ; And it STANDS as though it were holding one. Without this the shot played
  ; correctly and nobody could see it: a skeleton at rest with its arms down,
  ; a crossbow hanging at its side, and a one-second clip between two frames of
  ; that -- which reads as a bolt appearing out of its chest rather than as a
  ; creature shooting. Idle is what a thing looks like for the other nine tenths
  ; of the time, and for this one it should be aiming.
  Idle = Ranged_2H_Aiming
End
