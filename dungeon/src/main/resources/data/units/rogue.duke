Hero
  Name = Rogue
  ; The template name is Rogue — it is what the spawner, his four Skill
  ; blocks and every test call him. It was
  ; "Hero" while he was the only one, which stopped being a name the moment there
  ; were three of them and became a category with one member in it.
  ;
  ; DisplayName is what the PLAYER is told he is called, and is a different
  ; question entirely: the template is which creature, this is who.
  DisplayName = Erika
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 4
    Height = 12
  End
  ; How far he sees — and, because it is the same number, how far the dungeon
  ; opens up around him. Everything beyond it is black: not the walls, not the
  ; floor, not what is standing on it. This used to be 600, which reaches the far
  ; corner of a 500x360 map, so the whole floor was laid out in front of the
  ; player before he took a step and there was nothing to discover.
  ;
  ; Further than anything down here can sense him — the largest is 55 — because
  ; an archer who cannot see past the range at which he is noticed has no range
  ; at all. He opens the exchange; they answer it.
  VisionRange = 70
  Modules = [
    ; HeroBody rather than the engine's ActiveBody: this one can grow, because the
    ; whole game is him becoming harder to kill. See uz.dukeengine.dungeon.level.
    GrowableBody
      ; ★ BEFORE HIS STRENGTH, whose ten points at twelve apiece go on as the body
      ; is built -- 550 in all, low enough that a careless walk into a second room
      ; can end the run.
      MaxHealth = 430
    End
    MoveUpdate
      ; ★ Before his agility: 27.2 and twelve points at 0.15 are 29.
      Speed = 27.2
      ; 0 = turn on the spot. TurnRate is SAGE's tank parameter: a positive rate
      ; makes a thing rotate toward its goal and curve along its facing, which is
      ; right for a vehicle and wrong for a man — sent back the way he came, the
      ; hero drove a wide arc instead of turning round.
      TurnRate = 0
    End
    WeaponUpdate
      ; ★ Before agility, which is his primary and adds all twelve of its points:
      ; 14 an arrow.
      Damage = 2
      ; A bow, and it is now free of VisionRange above rather than kept politely
      ; below it. It used to have to stay inside his sight, because nothing checked
      ; the distance and the two numbers were left to keep each other honest; miss
      ; that and he shot into the dark at things the fog had never shown him.
      ; EyesOnly checks it — near enough, nothing between, nothing standing higher
      ; — so this may be raised as far as the fight wants it.
      ;
      ; Longer than any monster's SenseRadius (the largest is 55), so he can open
      ; fire on something that has not noticed him. Everything down here reaches 8
      ; to 14 with its own weapon, so he outranges the dungeon many times over:
      ; that is the whole shape of playing him — he wins at distance and loses the
      ; moment anything arrives.
      ;
      ; Shooting is not free, though. A monster that is hit comes for whoever hit
      ; it from wherever it is standing, sense radius or no sense radius — see
      ; MonsterBrain. The first arrow starts the fight; it does not avoid it.
      AttackRange = 60
      ; Slower than a fist was. A longbow that fired twice a second would make the
      ; range free rather than earned.
      ReloadFrames = 24
      ; A bow is drawn standing still. He walks or he shoots, never both — which is
      ; what makes his range something he has to hold rather than something he keeps
      ; while retreating for ever. He carries on reloading on the way, and keeps
      ; whatever he was pointed at, so the shot leaves the moment he stops.
      AttackOnTheMove = No
    End
    ; His shots leave the bow and have to get there — see uz.dukeengine.dungeon.combat.
    Bow
    End
    ; He shoots at what he can see. This also switches the engine's own target
    ; acquisition off for him -- it is a nearest-enemy search that knows nothing
    ; about walls -- and hands the choosing to HeroBrain, which does. Monsters do
    ; not carry it: they fight at arm's length, with nothing in between.
    EyesOnly
    End
    ; Walks to whatever he is told to attack — see HeroBrain.
    HeroBrain
    End
    ; Q, W, E and R. Which four they are is not written here: this line says he has
    ; skills, and the Skill blocks at the end of this file say which. A second
    ; hero gets the same line and his own blocks.
    SkillBook
    End
    ; Health coming back on its own, at the rate his Hero block names.
    Recovery
    End
    ; Counts what he kills. He is worth nothing himself, and the engine's own four
    ; ranks are switched off (0 0 0), leaving a plain experience total for the game
    ; to spend on levels of its own devising.
    ExperienceModule
      ExperienceValue = 0
      ExperienceRequired = [0, 0, 0]
    End
  ]


; ---------------------------------------------------------------------------
; The hero.
;
; A different creature kit from the monsters, on a different skeleton, and the
; only thing here that carries something in its hand.
;
; He used to be described one file per movement, because an animation site hands
; its work out that way and every one of those files carries the same
; exporter-generated clip name inside it -- so the FILE was the only thing saying
; which was the run. A character KIT is the other way round: a few libraries,
; each holding dozens of clips under names that mean something. So he is named
; the way the monsters are, and moves by the same set they do: Humanoid, in
; data/animations/, whose files the kit sorts by what the movement is for.
;
; Facing turns the model's forward onto the engine's. A quarter out and he walks
; sideways, a half out and he moonwalks — so it is here rather than in Java, and
; correcting it is an edit.
;
; Naming no Model puts him back to a coloured capsule.
;
; The block's name is the CREATURE TEMPLATE it describes, and it
; is the same word his Skill blocks are headed with. Repeatable: a second
; hero is a file like this one and a line in the game's Files (data/game.duke), and no
; Java. It used to be a single unnamed block whose fields were written straight
; onto the settings, so a second one would have quietly overwritten the first.
; ---------------------------------------------------------------------------

  ; ★ THE ROGUE'S OWN MESH. He wore the ranger's while he was the only hero and
  ; there was nobody for him to be told apart from; three heroes out of one pack
  ; have to be three silhouettes, and the kit ships five.
  ;
  ; He is still an archer -- every clip below is a bow clip and his weapon in
  ; his template is unchanged. What the mesh decides is what he LOOKS like, and
  ; a light hooded man with a bow is a better picture of "wins at distance, dies
  ; the moment anything arrives" than the ranger was.
  Model = models/heroes/rogue.glb
  ; GeometryHeight is 12 in his template above and the model boxes 2.180 tall, so
  ; 12 / 2.180 -- measured off the file, like every other number on this page.
  ; He is the SHORTEST of the three (knight 2.543, mage 2.655), so he is drawn
  ; the largest to stand the same twelve units tall as the other two.
  ModelScale = 5.50
  Facing = 90

  ; What he moves by, as everything on two legs does; the clips below are the ones
  ; he plays his own way.
  Animations = Humanoid

  ; Standing with the bow rather than empty-handed, because he is holding one.
  Idle = Ranged_Bow_Idle
  ; He moves at 45 against a monster's 24 -- a walk cycle at that speed reads as
  ; skating, so he runs.
  Walk = Running_A
  ; The loose, not the draw: the arrow leaves at the start of this clip, which is
  ; the frame the simulation fires on. Ranged_Bow_Draw is the other half of the
  ; shot if that reads better, and it is one word.
  Attack = Ranged_Bow_Release
  Hurt = Hit_A
  ; Death_A falls in 0.8s; Death_B takes 2.6s, which is longer than the floor
  ; stays open after he dies.
  Death = Death_A

  Held = [
    ; A character kit ships its weapons apart from its characters, and its rigs
    ; carry a bone to hang them on. One rogue and a rack of weapons is every armed
    ; rogue there is; a rogue-with-a-bow is one of them. The kit also ships him a
    ; dagger and a smokebomb, if he is ever anything but an archer.
    ;
    ; The bow goes in the LEFT hand because the right draws the string. If he ends
    ; up shooting left-handed, this is the line: handslot.r.
    Held
      Model = models/heroes/bow.gltf
      Bone = handslot.l
      ; Body and bow came out of the same pack at the same size.
      Scale = 1
      ; And half a turn about its own length, because the bone and the model disagree
      ; about which way round a bow goes.
      ;
      ; Every other weapon in the pack runs along its own +Y -- sword 1.78, dagger
      ; 1.21, staff 2.16 -- and the bow is the one that runs along +Z, 1.98 of it.
      ; The hand bone is authored for the first sort, so it stands the bow's length
      ; straight up, which is right, and then hands it over the wrong way round:
      ; measured down the length of the model, the STRING is the straight line at
      ; x = -0.33 and the grip is the bulge at +0.13, and the bone points +x at the
      ; archer. String outward, knuckles against the grip.
      ;
      ; A bow is symmetrical top to bottom, so the fix is one half-turn and nothing
      ; else needs touching.
      Roll = 180
    End

    ; ★ AND THE ARROWS FOR IT. A second Held, which is the whole of what the
    ; repeatable form is for: a bow with no quiver is a man who has brought one
    ; shot.
    ;
    ; ★ ON THE CHEST, because this rig has exactly TWO attachment points and both
    ; of them are hands -- handslot.l and handslot.r and nothing else. There is no
    ; back slot to hang it from, so it goes on the chest bone and is pushed into
    ; place by hand. Hung there with no shift it sits INSIDE him.
    ;
    ; HeldAt is x y z in the bone's own space, and the three numbers are: a little
    ; to his right, a little up, and back behind him. The quiver is 0.93 long, so
    ; half of it clears his shoulder. HeldPitch lies it back against him rather
    ; than standing it upright like a chimney.
    ;
    ; ★ These four numbers are the ones to nudge if it floats or sinks -- they are
    ; a guess at a placement, not a measurement of one, and the only way to settle
    ; them is to look.
    Held
      Model = models/heroes/quiver.gltf
      Bone = chest
      Scale = 1
      X = 0.12
      Y = 0.10
      Z = -0.22
      Pitch = -20
      Roll = 12
    End
  ]

  ; He stops here and shoots, well inside the 60 his bow reaches. This is the
  ; number that decides how he is played: lower it towards 4 and he walks into
  ; everything and brawls, which is what he used to do.
  CloseDistance = 48

  ; What the panel calls him under his name. His own rather than the panel's: one
  ; line in the Hud section was right while there was one hero, and became the
  ; archer's title on a knight the moment there were two.
  Title = O'q ustasi
  ; ★ WHAT HE IS MADE OF -- see Attributes in the World block. A line an attribute: which, what
  ; he starts with, what a level adds. AGILITY is his primary: it is his speed and
  ; the weight of his arrow both, and it grows fastest. At the first level these make
  ; exactly the archer he always was: 430 + 10 x 12 = 550 health,
  ; 27.2 + 12 x 0.15 = 29 speed, 2 + 12 = 14 an arrow.
  Primary = AGI
  Attributes
    STR = [10, 1.6]
    AGI = [12, 2.2]
    INT = [8, 1.0]
  End
  ; ★ WHAT HE CASTS OUT OF, before his intelligence: 40 + 8 x 5 = 80.
  MaxMana = 40
  ; ★ WHAT COMES BACK ON ITS OWN, in TENTHS of a point a second -- 15 is 1.5. Fixed:
  ; no attribute moves either, and slow on purpose. A pool that refills in a
  ; breath is a second cooldown; one that takes a minute is one he spends with care.
  ManaRegen = 15
  HealthRegen = 15


; The hero's own, because two of his states are things no monster has: a bow held
; ready, and a flourish for a new level. His clips come out of the Humanoid
; set he links above. Each is one word to change — worth trying:
; Idle_A / Idle_B / Ranged_Bow_Aiming_Idle for the standing ones, Death_B for a
; slower fall (2.6s, longer than the floor stays open), Interact / Throw /
; Ranged_Bow_Draw_Up for the flourish.
  ; Standing with the bow, as he stands in the world.
  Portrait = PortraitArt
    Calm = Ranged_Bow_Idle
    ; Drawn and waiting rather than loosing: he "has a target" for a whole
    ; engagement, so a release clip here would have him shooting continuously and
    ; none of it would be a shot.
    Fight = Ranged_Bow_Aiming_Idle
    ; The plainer of the two idles, run faster — see HurtSpeed above.
    Hurt = Idle_B
    ; Death_A falls in 0.8s.
    Dead = Death_A
    ; Rising out of the ground, which reads as power arriving.
    LevelUp = Spawn_Ground

    ; ★ Re-measured for his own mesh. He boxes 2.180 against the ranger's 2.275 and
    ; his head joint sits at 0.569 of that against 0.546 -- a shorter model with a
    ; proportionally larger head -- so the ranger's 0.74 would have framed him low
    ; and cut the top of his hood off. The camera aims about 0.20 above the joint
    ; on all three of them, which is the rule the knight's numbers follow too.
    Head = 0.77
    Show = 0.63
    Yaw = 22
    Pitch = -4
    Fov = 34
    HurtBelowPercent = 30
    HurtSpeed = 1.5
  End

  ; ---------------------------------------------------------------------------
  ; Skills
  ;
  ; A block per skill, headed by the hero it belongs to and the key that casts it.
  ; Skills are the hero's, not the game's: a second hero is four more blocks here
  ; and a SkillBook line in his creature block, with no Java at all. Two heroes may
  ; share an Effect and differ in every number, which is why the effect is named
  ; separately from the skill.
  ;
  ; Effect is the only part of a skill written in code, and there are seven:
  ;
  ;   STRIKE        hurt one enemy you point at, within Range. With a Projectile
  ;                 the shot CHASES and never misses; the cost is the flight time.
  ;   AREA_DAMAGE   hurt everything within Radius of yourself. Nothing to point at.
  ;                 Name a DurationFrames and a TickFrames as well and it goes on
  ;                 landing rather than landing once -- a whirlwind instead of a
  ;                 blast -- and it FOLLOWS you, because it is measured from where
  ;                 you are standing each time. Damage is per landing either way.
  ;   AREA_AT_SPOT  hurt everything within Radius of a spot you point at, up to
  ;                 Range away. Pointing past Range means "as far that way as I
  ;                 can" rather than a refusal -- the ring on screen says so. Name a
  ;                 SlowFrames and whoever it caught is slowed as well.
  ;   SKILLSHOT     throw a Projectile Range units in the direction you point, and
  ;                 it hits whoever is standing in the way. It CAN miss, which is
  ;                 the whole point: it rewards reading where a monster is going
  ;                 instead of clicking on it. Radius is how wide the shot is.
  ;   DASH          travel Distance along your facing, toward a spot. Name a Damage
  ;                 and it hurts whoever you went THROUGH, within Radius of the line
  ;                 you travelled -- a charge instead of a sprint. It does not shove
  ;                 anything aside; that is a question about the navigation grid.
  ;   EMPOWER       BoostPercent more damage for DurationFrames. Nothing to point at.
  ;   GUARD         BoostPercent LESS damage taken, for DurationFrames. EMPOWER's
  ;                 mirror and not a negative of it: that one changes what you deal,
  ;                 through the player's weapon bonus, and this changes what you
  ;                 take, through your body's armour. Nothing to point at.
  ;   HEAL          a monster's, so far: call the Projectile down on one of your own
  ;                 below HealBelowPercent of his health, within Range and in plain
  ;                 sight, and it gives back Heal when it lands, WindUpFrames later.
  ;   SUMMON        a monster's, so far: open SummonCount of the Projectile round you,
  ;                 Radius away and toward where you point first, and a Summons climbs
  ;                 out of each WindUpFrames later. They last DurationFrames, are worth
  ;                 SummonExperiencePercent of their own kind, and no more than
  ;                 MaxSummoned of one caster's stand at once.
  ;
  ; Each one already knows what the player must point at, so binding its key and
  ; drawing its ring both follow from the effect and neither is written twice.
  ;
  ; The two heroes below use six of the seven between them, and the seventh is here
  ; for the ones that come next: a spear thrown down a corridor is one SKILLSHOT
  ; block and not a line of Java.
  ;
  ; ★ A KEY BELONGS TO A SLOT, NOT TO A SKILL. Both heroes cast on Q, W, E and R,
  ; so the file holds two skills on Q — and only the played hero's are bound, his
  ; rings drawn and his slots filled. Which hero that is, is DefaultHero in
  ; the World block's Run section. Give a third hero the same four letters; nothing collides.
  ;
  ; Everything with PerLevel grows straight from the hero's level, computed in one
  ; step rather than accumulated, so a level 7 hero is the same however he got
  ; there. CooldownPerLevel is negative because a cooldown improves by shrinking.
  ; MaxRank and LevelPerRank are what make an ultimate an ultimate: fewer ranks,
  ; and each of them waiting for a hero level. See SkillRanks.
  ;
  ; Frames, not seconds: 30 frames is a second of game time, and a cooldown counted
  ; in frames is the same cooldown on every machine.
  ; ---------------------------------------------------------------------------

  Skills = [
    Skill
      Key = Q
      ; A heavy shot at one target, reaching past his ordinary bow. The reliable
      ; answer to a single dangerous thing, and the skill that is nearly always up.
      Effect = STRIKE
      ; He draws before he looses. Half a second of standing and aiming, and then a
      ; real arrow that has to cross the room — the same shaft as his ordinary shot,
      ; drawn bigger and travelling slower, so the shot the player spent is the one
      ; he can watch. Without this the monster simply lost health and nothing on
      ; screen said why.
      WindUpFrames = 15
      Projectile = HeavyArrow
      Damage = 45
      DamagePerLevel = 7
      Range = 68
      CooldownFrames = 90
      CooldownPerLevel = -3
      ; Four points may go into it, and it waits for nothing but one of them.
      MaxRank = 4
      ; The picture in his slot. A path here and nothing in Java: a fifth skill is
      ; a fifth block of this file.
      Icon = icons/skills/skill_arrow_shot.png
      ; What it looks like going off -- see Effect Shot.
      Look = Shot
      Name = Og'ir o'q
      Blurb = Kamonni to'liq tortib bitta dushmanga og'ir o'q otadi. O'q xonani kesib o'tadi, shuning uchun nishon qochib ulgurishi mumkin.
      ManaCost = 14
      ManaCostPerLevel = 1
    End

    Skill
      Key = W
      ; For when they have reached him, which is the only way an archer dies. It goes
      ; off around himself, so it is the panic button rather than an opening move.
      Effect = AREA_DAMAGE
      Damage = 28
      DamagePerLevel = 4
      Radius = 40
      CooldownFrames = 180
      CooldownPerLevel = -5
      ; Four points may go into it, and it waits for nothing but one of them.
      MaxRank = 4
      Icon = icons/skills/skill_arrow_volley.png
      ; What it looks like going off -- see Effect Volley.
      Look = Volley
      Name = O'q yomg'iri
      Blurb = Atrofdagi hamma dushmanga bir vaqtda zarar yetkazadi. Qurshab olinganda bosiladi.
      ManaCost = 24
      ManaCostPerLevel = 2
    End

    Skill
      Key = E
      ; Distance, in whichever direction he is facing — into a fight or out of one.
      ; No damage on purpose: it is the skill that decides whether the other three
      ; get used, and giving it damage as well would make it the only one.
      Effect = DASH
      Distance = 58
      CooldownFrames = 150
      CooldownPerLevel = -4
      ; Four points may go into it, and it waits for nothing but one of them.
      MaxRank = 4
      Icon = icons/skills/skill_dash.png
      ; What it looks like going off -- see Effect Sprint.
      Look = Sprint
      Name = Chopish
      Blurb = Ko'rsatilgan tomonga tez siljiydi. Hech kimga zarar bermaydi — bu jangdan chiqish yo'li, jangga kirish emas.
      ManaCost = 16
      ManaCostPerLevel = 0
    End

    Skill
      Key = R
      ; The ultimate. Not a bigger version of W — a window, during which everything
      ; else he does is worth more. Long enough to spend Q and W inside it.
      ;
      ; "Everything" means his arrows and his skills alike. That is worth writing
      ; down because for a while it was not true: the boost rides the engine's damage
      ; seam, which only a weapon consults, so Q and W went out at their plain value
      ; while this said otherwise. His level bonus is a different thing and stays a
      ; weapon bonus — the skills grow on their own DamagePerLevel, and applying both
      ; would count the same level twice.
      Effect = EMPOWER
      BoostPercent = 80
      BoostPerLevel = 12
      DurationFrames = 180
      CooldownFrames = 900
      CooldownPerLevel = -30
      ; Half way up the ladder: the run has to be earned before it turns.
      ; Three points, and each waits for the hero: the first at level 4, the second
      ; at 8, the third at 12. A MINIMUM rather than an appointment -- pass on it at
      ; 8 and it is still there at 9.
      MaxRank = 3
      LevelPerRank = 4
      ; Lorc, game-icons.net (CC BY 3.0) — see CREDITS.md.
      Icon = icons/skills/skill_piercing_volley.png
      ; What it looks like going off -- see Effect Focus.
      Look = Focus
      Name = Nishonga ol
      Blurb = Bir muddat uning hamma zarbalari kuchliroq bo'ladi. O'zi hech kimga tegmaydi — bu boshqa hamma narsani qimmatroq qiladigan oyna.
      ManaCost = 40
      ManaCostPerLevel = 3
    End
  ]
End
