; ---------------------------------------------------------------------------
; The four at the bottom of the four floors.
;
; One each, in the order the World block's Depth section names them, and the last of them is
; the end of the game rather than the door to another floor. That is why there
; are four rather than one: a descent with no bottom asks only how much further,
; and four named things to get past is a route with an end on it.
;
; They climb, and the depth multiplier climbs under them (BossHealthPercentPerDepth
; and its neighbours), so what is written here is the shape of the fight rather
; than its difficulty -- the Warden is met at depth 1 where the multiplier is 1,
; and the Champion at depth 4 where it is 2.2.
;
; Each is one of the pack's four skeletons, worn large. The pack ships one
; texture, so what tells them apart is the model, the size and the tint.
; ---------------------------------------------------------------------------

Monster
  Name = Warden
  ; The first, and the one that teaches what a boss is: big, slow, and nothing
  ; else. Everything it does, an ordinary skeleton does smaller.
  DisplayName = Warden
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Cylinder
    Radius = 7
    Height = 18
  End
  VisionRange = 130
  GrowableBody
    MaxHealth = 300
  End
  MoveUpdate
    Speed = 12
    TurnRate = 0
  End
  WeaponUpdate
    Damage = 16
    AttackRange = 13
    ReloadFrames = 36
  End
  ; Tells the brain the frame a blow landed, so it stands and finishes the swing
  ; instead of walking off mid-blow. It launches nothing -- see Swing.
  Swing
  End
  ; Timers for the statuses it is wearing -- the engine's own, and today that
  ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
  ; StatusUpdate already counts it down and takes it off, so a monster that
  ; carries this thaws by itself whether or not whoever chilled it is still alive.
  StatusUpdate
  End
  ScriptModule
    Name = WardenBrain
  End
  ExperienceModule
    ; Worth a level or two on its own — it is the gate to the next depth.
    ExperienceValue = 90
    ExperienceRequired = [0, 0, 0]
  End


; ---------------------------------------------------------------------------
; The four at the bottom of the four floors.
;
; One per depth, named in order by the Depth section of the World block, and the list is
; also how many floors there are: kill the last of them and the run is won. Each
; is one of the pack's four skeletons worn large, so the thing in the last room
; is recognisably made of the same bones as the ones on the way to it — and just
; as recognisably not one of them.
;
; All four share what makes a boss a boss: they see across the floor, never give
; up, and swing slowly enough to be read. What differs is the creature, which is
; in each one's template, with the rest of its stats.
;
; Weight = 0 keeps every one of them out of ordinary room filling: a boss is
; placed, not rolled for.
; ---------------------------------------------------------------------------

  SenseRadius = 55
  ChaseRadius = 195
  CloseDistance = 4
  ; A boss room is bigger than an ordinary one, and the escort in it should
  ; fetch the boss rather than die in front of it.
  AlertRadius = 110
  RepathFrames = 8
  SwingFrames = 20
  MinDepth = 0
  Weight = 0
  ; Deliberately unlike every other monster, and unlike the hero: on the minimap
  ; this dot is the only thing telling the player where the floor ends.
  Colour = 0xFFFFFF
  Scale = 1.8
  ; The plain skeleton, grown until it is nothing like one. GeometryHeight is 18.
  Model = models/monsters/skeleton_minion.glb
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 8.3
  Held
    Model = models/monsters/axe.gltf
    Bone = handslot.r
    Scale = 1.2
  End
  Tint = 0xC9B8A0
End
