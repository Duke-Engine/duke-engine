Monster
  Name = Runner
  DisplayName = Runner
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 3
    Height = 9
  End
  VisionRange = 85
  Modules = [
    GrowableBody
      MaxHealth = 30
    End
    MoveUpdate
      ; Faster than the hero, which is the whole point of it: you cannot walk away.
      Speed = 34
      TurnRate = 0
    End
    WeaponUpdate
      Damage = 4
      AttackRange = 8
      ReloadFrames = 22
    End
    ; Tells the brain the frame a blow landed, so it stands and finishes the swing
    ; instead of walking off mid-blow. It launches nothing -- see Swing.
    Swing
    End
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End
    ScriptModule
      Name = RunnerBrain
    End
    ExperienceModule
      ExperienceValue = 8
      ExperienceRequired = [0, 0, 0]
    End
  ]


  ; Fast, frail, and comes in numbers. Notices further and gives up later, so a
  ; room of them arrives as a wave rather than a queue.
  SenseRadius = 45
  ChaseRadius = 91
  CloseDistance = 4
  AlertRadius = 70
  RepathFrames = 6
  ; Quick, and quick to recover: the one you cannot walk away from.
  SwingFrames = 8
  MinDepth = 1
  Weight = 30
  Colour = 0xF2C14E
  Scale = 0.75
  ; The same skeleton, smaller and in a hot wash so the two are told apart at
  ; a glance -- one texture serves the whole pack, so colour is what separates
  ; them. GeometryHeight is 9.
  Model = models/monsters/skeleton_minion.glb
  Animations = Humanoid
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 4.2
  Tint = 0xFFD08A
  Held = Held
    Model = models/monsters/blade.gltf
    Bone = handslot.r
  End
  ; It runs rather than walks: it is the one you cannot step away from.
  Walk = Running_A
End
