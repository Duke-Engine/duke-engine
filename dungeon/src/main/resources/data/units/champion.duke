Monster
  Name = Champion
  ; The last one, and the numbers the single boss used to have: at depth 4 the
  ; multiplier makes this 1320 health and 42 damage. Beat it and the run is over.
  DisplayName = Champion
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 8
    Height = 24
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 600
    End
    MoveUpdate
      Speed = 14
      TurnRate = 0
    End
    WeaponUpdate
      Damage = 24
      AttackRange = 14
      ReloadFrames = 34
    End
    Swing
    End
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End
    ScriptModule
      Name = ChampionBrain
    End
    ExperienceModule
      ExperienceValue = 160
      ExperienceRequired = [0, 0, 0]
    End
  ]


  SenseRadius = 55
  ChaseRadius = 195
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 8
  ; Slow enough to be read, which is most of what makes a boss fightable.
  SwingFrames = 20
  MinDepth = 0
  Weight = 0
  Colour = 0xFFFFFF
  Scale = 2.2
  ; Twice anything else, and darkened until it reads as its own creature.
  ; GeometryHeight is 24.
  Model = models/monsters/skeleton_warrior.glb
  Animations = Humanoid
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 11.1
  Held = Held
    Model = models/monsters/axe.gltf
    Bone = handslot.r
    Scale = 1.4
  End
  Tint = 0x6E4A55
End
