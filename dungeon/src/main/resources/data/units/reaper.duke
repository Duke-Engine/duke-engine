Monster
  Name = Reaper
  ; Fast. The archer's whole game is the distance he keeps, and this is the first
  ; thing down here that closes it faster than he can back away.
  DisplayName = Reaper
  KindOf = [INFANTRY, SELECTABLE, CAN_ATTACK]
  Geometry = Cylinder
    Radius = 6
    Height = 19
  End
  VisionRange = 130
  Modules = [
    GrowableBody
      MaxHealth = 380
    End
    MoveUpdate
      Speed = 26
      TurnRate = 0
    End
    WeaponUpdate
      Damage = 18
      AttackRange = 13
      ReloadFrames = 24
    End
    Swing
    End
    ; Timers for the statuses it is wearing -- the engine's own, and today that
    ; means SLOWED. MoveUpdate already halves the step of anything wearing it, and
    ; StatusUpdate already counts it down and takes it off, so a monster that
    ; carries this thaws by itself whether or not whoever chilled it is still alive.
    StatusUpdate
    End
    ScriptModule
      Name = ReaperBrain
    End
    ExperienceModule
      ExperienceValue = 110
      ExperienceRequired = [0, 0, 0]
    End
  ]


  SenseRadius = 55
  ChaseRadius = 195
  CloseDistance = 4
  AlertRadius = 110
  RepathFrames = 6
  ; Quicker than the rest of them, which is the whole of what it is.
  SwingFrames = 12
  MinDepth = 0
  Weight = 0
  Colour = 0xFFFFFF
  Scale = 1.6
  ; The hooded one. It boxes 3.05 rather than 2.17, so its scale is the odd one.
  Model = models/monsters/skeleton_rogue.glb
  Animations = Humanoid
  ; What is looking at you out of the dark.
  Effect = EmberEyes
  ModelScale = 6.2
  Held = Held
    Model = models/monsters/blade.gltf
    Bone = handslot.r
    Scale = 1.3
  End
  Tint = 0x8FA9C8
End
