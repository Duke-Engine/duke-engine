; Duke Dungeon — the game itself: every data file it is made of, in the order it is
; read, and the map it opens on.
;
; A unit's file is the whole of it: its template (modules and stats), what it does,
; how it looks, its portrait and its skills. A HERO's health, speed and blow there
; are what his attributes are added to — see the Attribute blocks in
; data/world/world.duke. Monsters carry GrowableBody, because depth raises their health
; after they are built; props carry no Body at all, which is why nothing targets them.
;
; The order is not tidiness. Monster kinds are drawn in it, heroes are offered in
; it, skills are read in it and maps are listed in it, so a file moved up this list
; changes which monster a seed rolls. The Mage reads after the skeleton casters
; because that is the order their skills always had. A new unit is a file and a
; line here — no Java.
Game
  ; Which map this build opens on, by its Name, if it opens on one at all. Blank
  ; is the choice between the endless descent and every map drawn once below,
  ; which is what this game is when nobody has said otherwise.
  ;
  ; Beaten by the command line, which is what an author uses while building one:
  ;
  ;   ./gradlew :dungeon:run --args="--map=first"
  ;
  ; A map's Name, or the path of a map file: looked for on disk first and inside
  ; the game second, so an author edits a file and a player installs one. Maps
  ; are drawn with ./gradlew :dungeon:newMap and filled on the IDE's Map tab.
  StartMap =

  Files = [
    ; The world: its rules, its panel, how it is lit, and what its floors are built of.
    data/world/world.duke,
    data/world/hud.duke,
    data/world/scene.duke,
    data/world/themes/dungeon.duke,
    data/world/themes/forest.duke,

    ; Where it is played: the endless descent, drawn from a seed every time, and
    ; the maps drawn once, offered in this order.
    data/maps/endless.duke,
    data/maps/first.duke,
    data/maps/deep.duke,

    ; What everything on two legs moves by, linked from each unit.
    data/animations/humanoid.duke,

    data/units/rogue.duke,
    data/units/knight.duke,
    data/units/skeleton.duke,
    data/units/runner.duke,
    data/units/brute.duke,
    data/units/stalker.duke,
    data/units/revenant.duke,
    data/units/skeleton_mage.duke,
    data/units/skeleton_healer.duke,
    data/units/skeleton_summoner.duke,
    data/units/mage.duke,
    data/units/warden.duke,
    data/units/reaper.duke,
    data/units/necromancer.duke,
    data/units/champion.duke,

    data/projectiles/arrow.duke,
    data/projectiles/heavy_arrow.duke,
    data/projectiles/bolt.duke,
    data/projectiles/fireball.duke,
    data/projectiles/greater_fireball.duke,
    data/projectiles/mage_bolt.duke,
    data/projectiles/mage_fireball.duke,
    data/projectiles/skull_fireball.duke,
    data/projectiles/holy_spark.duke,
    data/projectiles/mending_light.duke,
    data/projectiles/shadow_spark.duke,
    data/projectiles/summoning_rift.duke,
    data/projectiles/meteor_mark.duke,

    ; The effects, from the kit: its starter set, by what each one is. A block of this
    ; game's own with the Name of one of them, in a file listed after these, is
    ; drawn instead of the kit's.
    kit/data/effects/fire/flame_arrow.duke,
    kit/data/effects/fire/fire_bolt.duke,
    kit/data/effects/fire/greater_fire_bolt.duke,
    kit/data/effects/fire/fireball.duke,
    kit/data/effects/fire/meteor_call.duke,
    kit/data/effects/fire/meteor.duke,
    kit/data/effects/ice/frost_nova.duke,
    kit/data/effects/holy/holy_light.duke,
    kit/data/effects/holy/holy_spark.duke,
    kit/data/effects/holy/mending_light.duke,
    kit/data/effects/shadow/shadow_spark.duke,
    kit/data/effects/shadow/dark_fireball.duke,
    kit/data/effects/shadow/summoning_rift.duke,
    kit/data/effects/arcane/arcane_bolt.duke,
    kit/data/effects/arcane/blink.duke,
    kit/data/effects/arcane/cast_flash.duke,
    kit/data/effects/strike/shot.duke,
    kit/data/effects/strike/sprint.duke,
    kit/data/effects/strike/volley.duke,
    kit/data/effects/strike/charge.duke,
    kit/data/effects/strike/cleave.duke,
    kit/data/effects/strike/whirlwind.duke,
    kit/data/effects/aura/focus.duke,
    kit/data/effects/aura/ember_eyes.duke,
    kit/data/effects/aura/guard.duke,
    kit/data/effects/moments/arrival.duke,
    kit/data/effects/moments/golden_pillar.duke,

    data/props/pillar.duke,
    data/props/statue.duke,
    data/props/barrel.duke,
    data/props/chest.duke,

    data/sounds/sfx.duke,
    data/sounds/ui.duke,
    data/sounds/voice.duke,
    data/sounds/music.duke,
  ]
End
