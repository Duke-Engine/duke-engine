; ---- the bow, which is heard more than anything else ----------------------

; ★ A KEY HE COULD NOT PAY FOR. The one sound in the game for something that did
; NOT happen, and it earns its place: a skill on cooldown says so on the socket
; -- swept, counting down -- and a skill he cannot afford looks exactly like a
; key that did not register. Without this, the answer is on the panel and the
; player is looking at the fight.
;
; Quiet, and the interface channel rather than effects, because it is the game
; answering him rather than something happening in the world. Delete the block
; and the bar flashing blue is the whole of the feedback.
Sound
  Name = no_mana
  Channel = Ui
  Positional = No
  Gain = 0.35
  Files = [audio/ui/click_2.ogg]
End

Sound
  Name = depth
  Channel = Ui
  Positional = No
  Files = [audio/sfx/descend.ogg]
End

; ---- the screen -----------------------------------------------------------

Sound
  Name = menu_hover
  Channel = Ui
  Positional = No
  Gain = 0.4
  Files = [audio/ui/hover.ogg]
End

Sound
  Name = menu_click
  Channel = Ui
  Positional = No
  Gain = 0.6
  Files = [audio/ui/click_1.ogg, audio/ui/click_2.ogg]
End

; The tick under an order mark -- see OrderMark in the World block.
;
; Quiet on purpose, and quieter than the same file is in a menu: this is heard on
; every click of a session rather than a few times an hour, and a sound at that
; rate has to sit under the notice rather than in it. It is the click landing,
; not an announcement that it landed.
Sound
  Name = order_mark
  Channel = Ui
  Positional = No
  Gain = 0.2
  Files = [audio/ui/click_1.ogg, audio/ui/click_2.ogg]
End

Sound
  Name = level_up
  Channel = Ui
  Positional = No
  ; A climb of notes, as the light he levels in climbs. Loud and held for most of
  ; a second, so it is turned well down to sit with the rest of the interface.
  Gain = 0.3
  Files = [audio/ui/level_up.ogg]
End

Sound
  Name = power_taken
  Channel = Ui
  Positional = No
  Files = [audio/ui/power_taken.ogg]
End

Sound
  Name = died.Hero
  Channel = Ui
  Positional = No
  Files = [audio/ui/hero_death.ogg]
End
