; ---- what Erika says ------------------------------------------------------
;
; The pack is a game-show and military set rather than a fantasy one, so these
; are the lines that carry over and the rest were left where they were. What is
; used reads as a soldier's answers, which suits a hero who fights for a living
; better than the numbers and the quiz answers would have.

Sound
  Name = vo.select
  Channel = Voice
  Positional = No
  Files = [audio/voice/select_1.ogg, audio/voice/select_2.ogg]
End

Sound
  Name = vo.move
  Channel = Voice
  Positional = No
  Files = [
    audio/voice/move_1.ogg,
    audio/voice/move_2.ogg,
    audio/voice/move_3.ogg,
    audio/voice/move_4.ogg,
  ]
End

Sound
  Name = vo.attack
  Channel = Voice
  Positional = No
  Files = [
    audio/voice/attack_1.ogg,
    audio/voice/attack_2.ogg,
    audio/voice/attack_3.ogg,
    audio/voice/attack_4.ogg,
  ]
End

Sound
  Name = vo.kill
  Channel = Voice
  Positional = No
  Files = [audio/voice/kill.ogg]
End

Sound
  Name = vo.hurt
  Channel = Voice
  Positional = No
  Files = [audio/voice/hurt_1.ogg, audio/voice/hurt_2.ogg]
End

Sound
  Name = vo.level_up
  Channel = Voice
  Positional = No
  Files = [audio/voice/level_1.ogg, audio/voice/level_2.ogg, audio/voice/level_3.ogg]
End

Sound
  Name = vo.death
  Channel = Voice
  Positional = No
  Files = [audio/voice/death_1.ogg, audio/voice/death_2.ogg]
End

Sound
  Name = vo.depth
  Channel = Voice
  Positional = No
  Files = [audio/voice/depth_1.ogg, audio/voice/depth_2.ogg]
End
