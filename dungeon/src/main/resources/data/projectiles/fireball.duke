Projectile
  Name = Fireball
  DisplayName = Fireball
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


  ; No model at all. It is a glowing body and a trail, both of which the effect
  ; draws, so there is nothing here but where it flies and what it burns like.
  Height = 7
  Tint = 0xFF8A3C
  Effect = FireBolt
  ; A ball has no head to burn at, so the fire sits where the ball is. Written
  ; anyway rather than left out: the two have to agree, and leaving it out is
  ; what put the ball on the floor under its own flame.
  EffectOffset = 0
End
