; The one the Necromancer throws: the same creature again, drawn three times the
; size. A separate template rather than a number on the thrower, because how big
; a thing is drawn belongs to the thing.
Projectile
  Name = GreaterFireball
  DisplayName = Fireball
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


  ; The Necromancer's. The same fire as the Revenant's and nothing else about it
  ; is different -- it is thrown by something three times the size, so it is
  ; three times the ball. Higher too, because it leaves a staff held twenty units
  ; off the ground rather than thirteen.
  Height = 12
  Tint = 0xFF8A3C
  Effect = MageFireGreater
  EffectOffset = 0
End
