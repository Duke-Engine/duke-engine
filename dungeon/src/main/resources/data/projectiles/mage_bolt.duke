; The mage's ordinary shot. No body and no geometry, one ArrowUpdate -- the same
; creature every other thing in flight is. What makes it his is how it is drawn,
; which is the block below.
Projectile
  Name = MageBolt
  DisplayName = Arcane Bolt
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


; The mage hero's ordinary shot. Cold rather than hot, and that is the whole
; job it has to do: what comes out of HIS staff must not be mistaken across a
; dark room for what comes out of the Revenant's. No model, like the fireballs --
; it is a glowing body and a trail, both of which the effect draws.
  Height = 7
  Tint = 0x6FD4FF
  Effect = ArcaneBolt
  EffectOffset = 0
End
