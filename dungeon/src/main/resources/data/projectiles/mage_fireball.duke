; And the thing Q throws, which is the same creature again at a different size
; and in a different colour. It bursts where it lands, and how far that reaches
; is the SKILL's Radius rather than anything here: an arrow does not know what
; loosed it.
Projectile
  Name = MageFireball
  DisplayName = Fireball
  VisionRange = 0
  Modules = [
    ArrowUpdate
    End
  ]


; And what Q throws. The same shape as the monsters' fire and half again the
; size, because it is the one shot of his the player chose to spend -- the same
; bargain HeavyArrow strikes against Arrow.
  Height = 7
  Tint = 0xFF9A3C
  Effect = Fireball
  EffectOffset = 0
End
