MaterialDef Fogged Terrain {

    MaterialParameters {
        Int BoundDrawBuffer

        // The surface itself: a colour, and a texture atlas if the kit has one.
        Texture2D ColorMap
        // Whether each vertex carries how much of this surface shows there -- a picture laid over
        // other ground and faded into it. Off for the ground itself, which then pays nothing for it.
        Boolean VertexAlpha
        // Whether each vertex carries the light that falls on it, worked out once per corner of the ground from the
        // ground's own lights -- the reference's terrain lights -- in place of the one sun and ambient below.
        Boolean VertexLight
        // Whether each vertex carries a colour its picture is multiplied by: scenery's baked shadow, where a tree's
        // crown is dark inside and a house's eaves shade its wall.
        Boolean VertexShade
        // A cut-out picture: what its alpha puts below this is not drawn at all (a leaf spray).
        Float AlphaDiscard
        Color Color
        // How much of the scene's ambient light this surface returns, already
        // multiplied by the ambient light itself -- the client has one sun and one
        // flat ambient and hands them over rather than asking the engine's light
        // system for them, because this shader is only ever used on terrain.
        Color Ambient
        Color Sun
        Vector3 SunDirection
        // The hour's shift of the ambient and the sun each was built with, laid over all the ground at once.
        Color AmbientShift
        Color SunShift

        // The dark: rgb is its colour, a is how much of it there is.
        Texture2D FogMap
        // How wide and deep the map is, so a vertex can say where on it it stands -- or, where the picture is of a
        // window round the camera laid over and over, how much ground one copy of it holds.
        Vector2 FogSize
        // Where the picture is of a window: the ground it holds now, x and z from, then x and z to. Past it the
        // picture holds another place's dark, so past it is drawn never seen.
        Vector4 FogWindow
        // A haze: x and z of where the camera looks, then from how far and to how far the ground fades into the fog's
        // own colour -- the window's background -- so the edge of the ground built round the camera is never seen.
        Vector4 Haze

        // What is burning nearby -- eight slots, always all eight, an unused one
        // carrying a black colour. See the note in the fragment shader for why
        // this shader carries its own lights instead of asking the engine.
        Vector4Array PointLightColours
        Vector4Array PointLightPositions

        // Up to two pictures multiplied over all the ground, laid by world position: xy is one over how much ground
        // a copy covers, zw where it has slid to. The reference's clouds and its fixed macro noise.
        Texture2D ShadeMap
        Vector4 ShadePlace
        Texture2D ShadeMap2
        Vector4 ShadePlace2
        // How much of them shows: 1, or 0 where the game has put them away.
        Float ShadeShown

        // Ground blended from its paint: up to eight surfaces, each vertex carrying their weights in its second and
        // third texture coordinates. Each surface is laid across the world: one over how much ground a copy covers, for
        // surfaces 0-3 and 4-7, and a colour it is multiplied by.
        Boolean Blended
        Texture2D Surface0
        Texture2D Surface1
        Texture2D Surface2
        Texture2D Surface3
        Texture2D Surface4
        Texture2D Surface5
        Texture2D Surface6
        Texture2D Surface7
        Vector4 SurfaceScale0
        Vector4 SurfaceScale1
        Vector4Array SurfaceTints
        // How narrow a border between two surfaces is: 1 a ramp across the cell, more a narrower one.
        Float BlendSharp
        // A picture whose four channels move each border, laid across the world one over NoiseScale units a copy, by
        // as much as BlendRagged: borders ragged rather than the shape of the cells.
        Texture2D BlendNoise
        Float NoiseScale
        Float BlendRagged
        // A large picture whose red channel varies each surface by as much as its share of SurfaceVariation0 and 1,
        // laid one over VariationScale units a copy: one picture over a valley not repeating to the eye.
        Texture2D Variation
        Float VariationScale
        Vector4 SurfaceVariation0
        Vector4 SurfaceVariation1
        // Steep ground drawn as rock: the picture laid on the face along its own direction, one over CliffScale units
        // a copy, wherever the ground's normal stands lower than CliffSlope -- the cosine of the lean past which it is
        // cliff.
        Texture2D Cliff
        Float CliffScale
        Float CliffSlope
        // Drawn instanced — ground cover's pieces, a model a chunk (E100).
        Boolean UseInstancing
    }

    Technique {
        VertexShader   GLSL310 GLSL300 GLSL150 GLSL100 : MatDefs/duke/FoggedTerrain.vert
        FragmentShader GLSL310 GLSL300 GLSL150 GLSL100 : MatDefs/duke/FoggedTerrain.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            ViewMatrix
            ViewProjectionMatrix
        }

        Defines {
            AMBIENT_SHIFT : AmbientShift
            SUN_SHIFT : SunShift
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            HAS_COLORMAP : ColorMap
            VERTEX_ALPHA : VertexAlpha
            VERTEX_LIGHT : VertexLight
            VERTEX_SHADE : VertexShade
            ALPHA_DISCARD : AlphaDiscard
            HAS_SHADEMAP : ShadeMap
            HAS_SHADEMAP2 : ShadeMap2
            FOG_WINDOW : FogWindow
            HAZE : Haze
            BLENDED : Blended
            BLEND_NOISE : BlendNoise
            BLEND_VARIATION : Variation
            BLEND_CLIFF : Cliff
            INSTANCING : UseInstancing
        }
    }

    // What casts a shadow of the sun: cut-outs by their picture, and instanced where the piece is.
    Technique PreShadow {
        VertexShader   GLSL310 GLSL300 GLSL150 GLSL100 : MatDefs/duke/FoggedPreShadow.vert
        FragmentShader GLSL310 GLSL300 GLSL150 GLSL100 : MatDefs/duke/FoggedPreShadow.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            ViewMatrix
            ViewProjectionMatrix
        }

        Defines {
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            HAS_COLORMAP : ColorMap
            ALPHA_DISCARD : AlphaDiscard
            INSTANCING : UseInstancing
        }

        ForcedRenderState {
            FaceCull Off
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }
    }
}
