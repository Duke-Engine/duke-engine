; The Skeleton Mage's fireball: the Mage's own, layer for layer, burning violet
; instead of gold, so a player can tell at a glance whose fire is coming at him.
; Its blast is measured in the skill's Radius exactly as his is, and what it throws,
; how big it flashes and how far it lights are drawn to that smaller blast. It knocks
; the camera half as hard: this is the monster's shot, not his.
Effect
  Name = DarkFireball

  Layers = [
    Layer
      Name = Core
      Type = AURA
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.35
      Count = 8
      Rate = 40
      Life = [0.12, 0.2]
      Size = [10, 7]
      Colour = [0xFFB8FB, 0xDF30FF]
      Alpha = [1, 0.6]
      Radius = 0.3
    End,

    Layer
      Name = Heart
      Type = AURA
      Texture = kit/effects/particles/fire_02.png
      Blend = Additive
      Cover = 0.5
      Count = 12
      Rate = 50
      Life = [0.15, 0.25]
      Size = [11, 6]
      SizeJitter = 0.25
      Colour = [0xF040FF, 0x8B00E0]
      Alpha = [1, 0]
      Radius = 1
      Spin = 240
    End,

    Layer
      Name = Flames
      Type = TRAIL
      Texture = kit/effects/particles/fire_01.png
