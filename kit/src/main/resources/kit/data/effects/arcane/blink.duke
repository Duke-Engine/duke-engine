Effect
  Name = Blink
  ; E. Both ends, and it is the one effect whose WHOLE job is the pair: a flash
  ; where he was and a flash where he is, with nothing drawn in between. That
  ; absence is the skill -- a dash draws the same two rings and the player reads
  ; it as travel because the man crossed the gap; here he does not.
  ;
  ; Sharp and short, so the two read as one event rather than as two casts.

  Layers = [
    ; Both ends of the blink, and a thread of violet between them for a quarter of a
    ; second: the place he left and the place he arrived are one event, and the line is
    ; what says so.
    Layer
      Name = Flash
      Type = IMPACT
      Texture = kit/effects/particles/magic_03.png
      Blend = Additive
      Cover = 0.2
      At = BOTH
      Count = 1
      Life = [0.3, 0.3]
      Size = [8, 26]
      SizeEase = 3
      Colour = [0xF4E8FF, 0xA060FF]
      Alpha = [1, 0]
      FadeOut = 0.6
      Spin = 180
      Height = 5
    End,

    Layer
      Name = Motes
      Type = BURST
      Texture = kit/effects/particles/magic_05.png
      Blend = Additive
      At = BOTH
      Count = 16
      Radius = 3
      Life = [0.4, 0.7]
      Size = [2.6, 0.4]
      SizeJitter = 0.4
      Colour = [0xECDDFF, 0x8A4AFF]
      Speed = [6, 14]
      Direction = UP
      Spread = 70
      Drag = 2
      Gravity = -6
      Height = 2
    End,

    Layer
      Name = Rune
      Type = RING
      Texture = kit/effects/particles/magic_01.png
      Blend = Additive
      Cover = 0.25
      At = BOTH
      Count = 1
      Life = [0.45, 0.45]
      Size = [8, 26]
      SizeEase = 3
      Colour = [0xE0CCFF, 0x9050FF]
      Alpha = [1, 0]
      FadeOut = 0.5
      Spin = 120
      Height = 0.4
    End,

    Layer
      Name = Thread
      Type = BEAM
      Texture = kit/effects/particles/trace_06.png
      Blend = Additive
      At = PATH
      Count = 1
      Life = [0.25, 0.25]
      Size = [3, 0.5]
      Colour = [0xE0CCFF, 0x9050FF]
      Alpha = [0.8, 0]
      Height = 5
    End,

    Layer
      Name = Glint
      Type = LIGHT
      At = BOTH
      Seconds = 0.3
      LightColour = 0x9A5AFF
      LightPower = 2.6
      LightRadius = 50
      FadeOut = 0.85
    End
  ]
End
