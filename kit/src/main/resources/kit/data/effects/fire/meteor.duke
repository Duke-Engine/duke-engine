Effect
  Name = Meteor
  ; The mark, and then the landing. One block for both because they are one
  ; object at two moments: it glows on the floor for the second and a half it is
  ; falling, and its BURST is what happens when it stops existing.
  ;
  ; ★ The light is the warning. In a dark room a patch of floor going orange is
  ; read long before any outline is, which is why this is the one ground effect
  ; that is allowed a light of its own.
  ShakeSeconds = 0.26
  ShakePower = 1.8

  Layers = [
    ; The meteor itself, falling. It is carried by the mark on the floor, so every
    ; carried layer here names a Fall: it starts that far up and is brought down over
    ; the skill's wind-up, slow and then sudden. Then the landing, which is everything
    ; at once and is meant to be.
    Layer
      Name = Rock
      Type = AURA
      Texture = kit/effects/particles/fire_02.png
      Blend = Additive
      Cover = 0.55
      Count = 24
      Rate = 50
      Life = [0.15, 0.25]
      Size = [16, 10]
      Colour = [0xFFD080, 0xFF5A10]
      Alpha = [1, 0]
      Radius = 2
      Spin = 120
      Fall = 160
    End,

    Layer
      Name = Heart
      Type = AURA
      Texture = kit/effects/particles/circle_05.png
      Blend = Additive
      Cover = 0.3
      Count = 6
      Rate = 30
      Life = [0.12, 0.2]
      Size = [14, 10]
      Colour = [0xFFF0C8, 0xFFA040]
      Alpha = [1, 0.6]
      Fall = 160
    End,

    Layer
      Name = Flames
      Type = TRAIL
      Texture = kit/effects/particles/fire_01.png
      Blend = Additive
      Cover = 0.45
      Count = 56
      Rate = 80
      Life = [0.3, 0.5]
      Size = [14, 5]
      SizeEase = 2
      SizeJitter = 0.3
      Colour = [0xFFB040, 0x7A1000]
      ColourEase = 1.5
      Alpha = [1, 0]
      Speed = [2, 6]
      Direction = UP
      Spread = 30
      Drag = 2
      Spin = 80
      Fall = 160
    End,

    Layer
      Name = Wake
      Type = TRAIL
      Texture = kit/effects/particles/smoke_05.png
      Blend = Alpha
      Count = 28
      Rate = 22
      Life = [0.8, 1.2]
      Size = [8, 18]
      Colour = [0x5A504A, 0x2E2A28]
      Alpha = [0.55, 0]
      Speed = [1, 4]
      Direction = UP
      Spin = 20
      Fall = 160
    End,

    Layer
      Name = Glow
      Type = LIGHT
      LightColour = 0xFF6A18
      LightPower = 3.5
      LightRadius = 100
      Fall = 160
