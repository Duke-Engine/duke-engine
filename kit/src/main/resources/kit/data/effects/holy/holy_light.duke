; A heal: white and gold coming down onto whoever is mended, and motes drifting
; down round him. Played by nothing yet -- nothing in the game heals today -- and
; here for the first thing that does to name as its Look. It happens on whoever the
; cast is on, which is where SPOT puts a layer that follows.
Effect
  Name = HolyLight

  Layers = [
    Layer
      Name = Ring
      Type = RING
      Texture = kit/effects/particles/circle_02.png
      Blend = Additive
      Count = 1
      Delay = 0.12
      Life = [0.5, 0.5]
      Size = [8, 40]
      SizeEase = 3
      Colour = [0xFFFBEA, 0xFFD478]
      ColourEase = 2
      Alpha = [0.8, 0]
      FadeOut = 0
      Follows = Yes
    End

    Layer
      Name = Halo
      Type = PILLAR
      Texture = kit/effects/particles/pillar_halo.png
      Blend = Additive
      Count = 1
      Life = [0.7, 0.7]
      Size = [30, 26]
      SizeEase = 2
      Height = 80
      Direction = DOWN
      Rise = 0.3
      RiseEase = 3
      Colour = [0xFFF2C4, 0xFFC85A]
      ColourEase = 2.5
      Alpha = [0.55, 0]
      FadeIn = 0.04
      FadeOut = 0
      Follows = Yes
    End

    Layer
      Name = Core
      Type = PILLAR
      Texture = kit/effects/particles/pillar_core.png
      Blend = Additive
      Count = 1
      Life = [0.6, 0.6]
      Size = [10, 6]
      SizeEase = 2
      Height = 90
      Direction = DOWN
      Rise = 0.2
      RiseEase = 3
      Colour = [0xFFFFFF, 0xFFF0C4]
      ColourEase = 2.5
      Alpha = [1, 0]
      FadeIn = 0.03
      FadeOut = 0
      Follows = Yes
    End

    Layer
      Name = Motes
      Type = BURST
      Texture = kit/effects/particles/star_04.png
      Blend = Additive
      Count = 18
      Life = [0.55, 0.8]
      Size = [3.2, 0.5]
      SizeJitter = 0.4
      Colour = [0xFFFFF4, 0xFFD460]
      Alpha = [1, 0]
      Speed = [20, 50]
      Direction = DOWN
      Spread = 12
      Radius = 18
      Height = 50
      Gravity = 30
      Drag = 1
      Follows = Yes
    End

    Layer
      Name = Flash
      Type = LIGHT
      LightColour = 0xFFF0C0
      LightPower = 2.4
      LightRadius = 80
      Seconds = 0.7
      FadeIn = 0.12
      FadeOut = 0.8
      Follows = Yes
    End
  ]
End
