Effect
  Name = Sprint
  ; E. Two small rings, one at each end of the run -- the client is given both
  ; feet of a DASH -- so what it reads as is a puff of dust where he pushed off
  ; and another where he landed. No light and no sparks: he is running, not
  ; exploding.

  Layers = [
    ; The sprint: dust along the run that is gone almost as soon as it is up -- she
    ; is quick, and the trail says so by not staying -- a streak of speed over it, a
    ; kick of dust where she pushed off and a small ring where she landed.
    Layer
      Name = Dust
      Type = TRAIL
      At = PATH
      Texture = kit/effects/particles/smoke_03.png
      Blend = Alpha
      Seconds = 0.15
      Count = 16
      Radius = 2
      Life = [0.35, 0.5]
      Size = [5, 11]
      SizeEase = 2
      Colour = [0x7A6E62, 0x5A5048]
      Alpha = [0.65, 0]
      Speed = [2, 5]
      Direction = UP
      Spread = 50
      Drag = 3
      Gravity = -3
      Spin = 40
      Height = 1
    End,

    Layer
      Name = Streak
      Type = BEAM
      At = PATH
      Texture = kit/effects/particles/trace_07.png
      Blend = Additive
      Count = 1
      Life = [0.18, 0.18]
      Size = [22, 6]
      Colour = [0xE8F6FF, 0x9AD0FF]
      Alpha = [0.6, 0]
      Height = 5
    End,

    Layer
      Name = Kick
      Type = BURST
      At = FROM
      Texture = kit/effects/particles/smoke_03.png
      Blend = Alpha
      Count = 5
      Life = [0.35, 0.5]
      Size = [4, 10]
      SizeEase = 2
      Colour = [0x7A6E62, 0x5A5048]
      Alpha = [0.65, 0]
      Speed = [6, 12]
      Direction = BACK
      Spread = 40
      Drag = 4
      Spin = 40
      Height = 1
    End,

    Layer
      Name = Landing
      Type = RING
      At = TO
      Texture = kit/effects/particles/smoke_10.png
      Blend = Alpha
      Count = 1
      Life = [0.35, 0.35]
      Size = [6, 22]
      SizeEase = 2.4
      Colour = [0x7A6E62, 0x5A5048]
      Alpha = [0.6, 0]
      FadeOut = 0.6
      Spin = 30
      Height = 0.5
    End
  ]
End
