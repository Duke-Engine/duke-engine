Effect
  Name = Whirlwind
  ; R. The only ring in the game that is cast again and again -- the whirlwind
  ; lands every TickFrames for four seconds -- so it is deliberately the cheapest
  ; heavy-looking thing here: no sparks, no light, one wide fast ring. Eight of
  ; those over four seconds reads as a man turning; eight bursts with lights
  ; would be the whole light budget for the fight.
  ;
  ; ★ Every blow draws one now: SkillBook marks each tick, so the rings and sparks
  ; below come on every blow and the blades, which are an aura, once.
  ShakeSeconds = 0.10
  ShakePower = 0.6

  Layers = [
    ; The whirlwind: blades of light turning round him for the whole run -- no
    ; Seconds, so the skill's DurationFrames -- a gust turning the other way inside
    ; them, and on every blow it lands a ring of dust and a spray of sparks, so the
    ; player can see it is still going without counting. The blades are one each and
    ; are never stacked: every blow arrives as a cast, and a running aura is not
    ; started twice.
    Layer
      Name = Blades
      Type = AURA
      Measure = Reach
      Texture = kit/effects/particles/twirl_03.png
      Blend = Additive
      Cover = 0.15
      Count = 1
      Size = [1.9, 1.9]
      Colour = [0xFFF0D8, 0xFFF0D8]
      Alpha = [0.85, 0.85]
      FadeIn = 0.03
      FadeOut = 0.08
      Spin = 900
      Height = 5
    End

    Layer
      Name = Gust
      Type = AURA
      Measure = Reach
      Texture = kit/effects/particles/twirl_01.png
      Blend = Additive
      Count = 1
      Size = [1.3, 1.3]
      Colour = [0xFFD8A0, 0xFFD8A0]
      Alpha = [0.5, 0.5]
      FadeIn = 0.03
      FadeOut = 0.08
      Spin = -600
      Height = 4
    End

    Layer
      Name = Dust
      Type = RING
      Measure = Reach
      Texture = kit/effects/particles/smoke_10.png
      Blend = Alpha
      Count = 1
      Life = [0.5, 0.5]
      Size = [0.8, 2.6]
      SizeEase = 2.4
      Colour = [0x9A8A78, 0x6A5E54]
      Alpha = [0.35, 0]
      FadeOut = 0.6
      Spin = 60
      Height = 0.5
    End

    Layer
      Name = Sparks
      Type = BURST
      Texture = kit/effects/particles/star_04.png
      Blend = Additive
      Count = 10
      Radius = 20
      Life = [0.25, 0.4]
      Size = [1.4, 0.2]
      Stretch = 0.05
      Colour = [0xFFF0C0, 0xFF8A30]
      Speed = [30, 50]
      Direction = OUT
      Spread = 30
      Drag = 3
      Gravity = 40
      Height = 4
    End
  ]
End
